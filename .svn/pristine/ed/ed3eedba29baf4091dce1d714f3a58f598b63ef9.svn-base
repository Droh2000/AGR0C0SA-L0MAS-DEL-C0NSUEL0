package AgrocosaTransactions;

import SIDWebEngine.*;
import java.sql.*;
import xmlNodeArray.*;

public class CloseShippingTransaction extends SIDWebTransaction {

    static int QTY_ALLOWED = 24;
    protected PreparedStatement pstmtUpdatehippingInfo;
    protected PreparedStatement pstmtDeleteShippingInfo;
    protected PreparedStatement pstmtInsertShippingHistory;
    protected PreparedStatement pstmtInsertShippingHistory1;
    protected PreparedStatement pstmtInsertShippingHistoryArrival;
    protected PreparedStatement pstmtSelectShippingHistoryArrival;
    protected PreparedStatement pstmtSelectTotalShipping;
    protected PreparedStatement pstmtSelectInventory;
    protected PreparedStatement pstmtEditInventory;
    protected PreparedStatement pstmtInsertInventory;
    protected PreparedStatement pstmtInsertInventoryHistory;
    protected PreparedStatement pstmtSelectTotalLine;
    protected PreparedStatement pstmtSelectDiscountInventory;
    protected PreparedStatement pstmtSelectQtyAllowedByLine;

    /**
     * Default Constructor
     *
     * @exception (none)
     */
    public CloseShippingTransaction() {
        super();
        SetTransactionType(SIDWebTransaction.SaveType);
    }

    /**
     * Checks to see if the node Array is supported
     *
     * @param nodeArray
     * @return <B>true</B> if the nodeArray is supported. <B>false</B> otherwise
     * @exception (none)
     */
    @Override
    public boolean Supports(xmlNodeArray nodeArray) {

        //Add tag names as comma separated Strings to the mandatoryTags array
        String[] mandatoryTags = {
            "idShipping",
            "driverName"
        };

        //Add tag names as comma separated Strings to the optionalTags array
        String[] optionalTags = {};
        //Add tag names as comma separated Strings to the mandatorySets array
        String[] mandatorySets = {};
        //Add tag names as comma separated Strings to the optionalSetTags array
        String[] optionalSets = {};

        xmlNodeArray errArray = new xmlNodeArray();
        for (int i = 0; i < mandatoryTags.length; i++) {
            if (!nodeArray.existValue(mandatoryTags[i])) {
                System.out.println("<CloseShippingTransaction::Supports> " + mandatoryTags[i] + " Mandatory tag not found or value is empty/null");
                errArray.add("ERROR", "MANDATORY_TAG_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < optionalTags.length; i++) {
            if (nodeArray.exist(optionalTags[i]) && !nodeArray.existValue(optionalTags[i])) {
                System.out.println("<CloseShippingTransaction::Supports> " + optionalTags[i] + " Optional tag not found or value is empty/null");
                errArray.add("OPTIONAL_TAG_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < mandatorySets.length; i++) {
            if (nodeArray.find(mandatorySets[i]) == null || nodeArray.find(mandatorySets[i]).getTable() == null || nodeArray.find(mandatorySets[i]).getTable().getRowsQty() == 0) {
                System.out.println("<CloseShippingTransaction::Supports> " + mandatorySets[i] + " Mandatory Set not found or value is empty/null");
                errArray.add("MANDATORY_SET_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < optionalSets.length; i++) {
            if (nodeArray.find(mandatorySets[i]) != null && (nodeArray.find(mandatorySets[i]).getTable() == null || nodeArray.find(mandatorySets[i]).getTable().getRowsQty() == 0)) {
                System.out.println("<CloseShippingTransaction::Supports> " + optionalSets[i] + " Optional Set not found or value is empty/null");
                errArray.add("OPTIONAL_SET_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        return true;
    }

    /**
     * Prepares the SQL statements to be executed
     *
     * @return <B>true</B> for successful preparation; <B>false</B> for
     * unsuccessful preparation
     * @exception (none)
     */
    @Override
    public synchronized boolean PrepareStatements() {
        //Note1 : Use PreparedStatements instead of Statements where ever possible
        //Note2 : If transaction contains no prepared statements, delete entire function
        //        Unless there are nested transaction, then Prepare will call those.
        try {
            Connection con = this.GetSIDDataBase().GetConnection();

            pstmtUpdatehippingInfo = con.prepareStatement("update shipping "
                    + "set Active = ?, "
                    + "Status = 'Recibido', "
                    + "ReceiptDate = now(), "
                    + "Gate = ?, "
                    + "Line = ?, "
                    + "DriverName = ?, "
                    + "Comments = ? "
                    + "Where idShipping = ? ");

            pstmtDeleteShippingInfo = con.prepareStatement("delete from shipping "
                    + "Where idShipping = ? ");

            pstmtInsertShippingHistory = con.prepareStatement("insert into shippinghistory ( "
                    + "idShipping, "
                    + "ReceiptDate, "
                    + "Gate, "
                    + "DriverName, "
                    + "Status, "
                    + "Comments, "
                    + "InsertDate,"
                    + "Line,"
                    + "ArrivalDate "
                    + ") values( "
                    + "?, "//1 idShipping
                    + "now(), " // ReceiptDate
                    + "?, "//2 Gate
                    + "?, "//3 DriverName
                    + "?, "//4 Status
                    + "?, "//5 Comments
                    + "Now(), "
                    + "?, " //6 Line
                    + "? " //7 fechaLlegada
                    + ")");

            pstmtInsertShippingHistory1 = con.prepareStatement("insert into shippinghistory ( "
                    + "idShipping, "
                    + "ReceiptDate, "
                    + "Gate, "
                    + "DriverName, "
                    + "Status, "
                    + "Comments, "
                    + "InsertDate,"
                    + "Line,"
                    + "ArrivalDate "
                    + ") values( "
                    + "?, "//1 idShipping
                    + "now(), " // ReceiptDate
                    + "?, "//2 Gate
                    + "?, "//3 DriverName
                    + "?, "//4 Status
                    + "?, "//5 Comments
                    + "Now(), "
                    + "?, " //6 Line
                    + "Now() " //7 fechaLlegada
                    + ")");

            pstmtInsertShippingHistoryArrival = con.prepareStatement("insert into shippinghistory ( "
                    + "idShipping, "
                    + "ArrivalDate, "
                    + "Gate, "
                    + "DriverName, "
                    + "Status, "
                    + "Comments, "
                    + "InsertDate, "
                    + "Line "
                    + ") values( "
                    + "?, "//1 idShipping
                    + "now(), " // ReceiptDate
                    + "?, "//2 Gate
                    + "?, "//3 DriverName
                    + "?, "//4 Status
                    + "?, "//5 Comments
                    + "Now(), "
                    + "? " //6 Line
                    + ")");

            pstmtSelectShippingHistoryArrival = con.prepareStatement("select "
                    + "coalesce(ArrivalDate,'') as ArrivalDate "
                    + "from shippinghistory "
                    + "where idShipping = ? "
                    + "and status = 'Llegada' ");

            pstmtSelectTotalShipping = con.prepareStatement(""
                    + "SELECT '50SCY',50SCY FROM shipping where idShipping = ? " //1
                    + "UNION ALL SELECT '50CY',50CY FROM shipping where idShipping = ? " //2
                    + "UNION ALL SELECT '50JY',50JY FROM shipping where idShipping = ? " //3
                    + "UNION ALL SELECT '50LMY',50LMY FROM shipping where idShipping = ? " //4
                    + "UNION ALL SELECT '50SMY',50SMY FROM shipping where idShipping = ? " //5
                    + "UNION ALL SELECT '25JY',25JY FROM shipping where idShipping = ? " //6
                    + "UNION ALL SELECT '25LMY',25LMY FROM shipping where idShipping = ? " //7
                    + "UNION ALL SELECT '25SMY',25SMY FROM shipping where idShipping = ? " //8
                    + "UNION ALL SELECT '40CJY',40CJY FROM shipping where idShipping = ? " //9
                    + "UNION ALL SELECT '50CW',50CW FROM shipping where idShipping = ? " //10
                    + "UNION ALL SELECT '50JW',50JW FROM shipping where idShipping = ? " //11
                    + "UNION ALL SELECT '50LMW',50LMW FROM shipping where idShipping = ? " //12
                    + "UNION ALL SELECT '50SMW',50SMW FROM shipping where idShipping = ? " //13
                    + "UNION ALL SELECT '25CW',25CW FROM shipping where idShipping = ? " //14
                    + "UNION ALL SELECT '25JW',25JW FROM shipping where idShipping = ? " //15
                    + "UNION ALL SELECT '25LMW',25LMW FROM shipping where idShipping = ? " //16
                    + "UNION ALL SELECT '50CR',50CR FROM shipping where idShipping = ? " //17
                    + "UNION ALL SELECT '50JR',50JR FROM shipping where idShipping = ? " //18
                    + "UNION ALL SELECT '50LMR',50LMR FROM shipping where idShipping = ? " //19
                    + "UNION ALL SELECT '50SMR',50SMR FROM shipping where idShipping = ? " //20
                    + "UNION ALL SELECT '50PPR',50PPR FROM shipping where idShipping = ? " //21
                    + "UNION ALL SELECT '25CR',25CR FROM shipping where idShipping = ? " //22
                    + "UNION ALL SELECT '25JR ',25JR  FROM shipping where idShipping = ? " //23
                    + "UNION ALL SELECT '25LMR',25LMR FROM shipping where idShipping = ? " //24
                    + "UNION ALL SELECT '50JC',Jc FROM shipping where idShipping = ? " //25 Jc es de 50 y se divide entre 45
                    + "UNION ALL SELECT '50OX',Ox FROM shipping where idShipping = ? " //26 Ox es de 50 y se divide entre 45
                    + "UNION ALL SELECT 'SS DI',SSaxDi FROM shipping where idShipping = ? " //27
                    + "UNION ALL SELECT 'SS GREEN',SSaxGreen FROM shipping where idShipping = ? " //28
                    + "UNION ALL SELECT 'SS PURPLE',SSaxPurple FROM shipping where idShipping = ? " //29
                    + "UNION ALL SELECT 'SS BLUE',SSaxBlue FROM shipping where idShipping = ? " //30
                    + "UNION ALL SELECT 'SS CF',SSaxCF FROM shipping where idShipping = ? " //31
                    + "UNION ALL SELECT 'SS CY',SSCY FROM shipping where idShipping = ? " //32
                    + "UNION ALL SELECT 'SS JY',SSJY FROM shipping where idShipping = ? " //33
                    + "UNION ALL SELECT 'SS LMY',SSLMY FROM shipping where idShipping = ? " //34
                    + "UNION ALL SELECT 'SS CW',SSCW FROM shipping where idShipping = ? " //35
                    + "UNION ALL SELECT 'SS JW',SSJW FROM shipping where idShipping = ? " //36
                    + "UNION ALL SELECT 'SS LMW',SSLMW FROM shipping where idShipping = ? " //37
                    + "UNION ALL SELECT 'SS JR',SSJR FROM shipping where idShipping = ? " //38
                    + "UNION ALL SELECT 'SS LMR',SSLMR FROM shipping where idShipping = ? " //39
                    + "UNION ALL SELECT 'RP',Rp FROM shipping where idShipping = ? " //40
                    + "UNION ALL SELECT 'JCR',JCR FROM shipping where idShipping = ? " //41
                    + "UNION ALL SELECT 'SS SMY',SSSMY FROM shipping where idShipping = ? " //42
                    + "UNION ALL SELECT 'SS SMW',SSSMW FROM shipping where idShipping = ? " //43
                    + "UNION ALL SELECT 'SS SMR',SSSMR FROM shipping where idShipping = ? " //44
                    + "");

            pstmtSelectInventory = con.prepareStatement("select "
                    + "coalesce(idWarehouse,0) as id, "
                    + "coalesce(sum(Quantity),0) as Qty "
                    + "from warehouse "
                    + "where Linea = ? "
                    + "and Product = ? "
                    + "and ReferenceNumber = ? "
                    + "and Bag = 0 "
                    + "Group by idWarehouse");

            pstmtEditInventory = con.prepareStatement("update warehouse "
                    + "set Quantity = Quantity + ? "
                    + "where idWarehouse = ? ");

            pstmtInsertInventory = con.prepareStatement("insert into warehouse "
                    + "(Product, Quantity, Linea, ReferenceNumber) "
                    + "values(?,?,?,?)");

            pstmtInsertInventoryHistory = con.prepareStatement("INSERT INTO warehousehistory"
                    + "(ReferenceNumber, "
                    + "Movement, "
                    + "Trucking, "
                    + "Trailer, "
                    + "Line, "
                    + "Dock, "
                    + "DriverName, "
                    + "Seal, "
                    + "Destination, "
                    + "User, "
                    + "InsertDate, "
                    + "Comments,"
                    + "Product,"
                    + "Quantity)"
                    + "VALUES("
                    + "?, " //1. ReferenceNumber
                    + "'Entrada', " //Movement
                    + "?, " //2. Trucking
                    + "?, " //3. Trailer
                    + "?, " //4. Line
                    + "?, " //5. Dock
                    + "?, " //6. DriverName
                    + "?, " //7. Sello
                    + "'Bodega', "
                    + "?, " //8. User
                    + "now(), " //InsertDate
                    + "?, " //9. Comments
                    + "?, " //10. Producto
                    + "? " //11. Quantity
                    + ")");

            pstmtSelectTotalLine = con.prepareStatement("select sum(Quantity) as Qty "
                    + "from warehouse "
                    + "where linea = ? ");

            pstmtSelectDiscountInventory = con.prepareStatement("select "
                    + "Active "
                    + "from configuration "
                    + "where Tag = 'Entregas' "
                    + "and Value = 'DescontarInventario'");
            
            
            pstmtSelectQtyAllowedByLine = con.prepareStatement("SELECT "
                    + "Value as Qty "
                    + "FROM sidconfiguration "
                    + "Where Tag ='QtyAllowedByLine' ");

            this.addPreparedStatement(pstmtUpdatehippingInfo);
            this.addPreparedStatement(pstmtDeleteShippingInfo);
            this.addPreparedStatement(pstmtInsertShippingHistory);
            this.addPreparedStatement(pstmtInsertShippingHistory1);
            this.addPreparedStatement(pstmtInsertShippingHistoryArrival);
            this.addPreparedStatement(pstmtSelectShippingHistoryArrival);

            this.addPreparedStatement(pstmtSelectTotalShipping);
            this.addPreparedStatement(pstmtSelectInventory);
            this.addPreparedStatement(pstmtEditInventory);
            this.addPreparedStatement(pstmtInsertInventory);
            this.addPreparedStatement(pstmtInsertInventoryHistory);
            this.addPreparedStatement(pstmtSelectTotalLine);
            this.addPreparedStatement(pstmtSelectQtyAllowedByLine);

            return true;
        } catch (SQLException e) {
            System.out.println("CloseShippingTransaction::PrepareStatements> SQLException: " + e.getMessage());
            return false;
        }
    }

    /**
     * executes sql statements using input arguments and returns result
     *
     * @return valid node array if successful else null
     * @exception SQLException if sql error occurs
     * @exception Exception if non sql error occurs
     */
    @Override
    public synchronized xmlNodeArray Execute() throws SQLException, Exception {
        Connection conn = null;
        xmlNodeArray resultArray = null;
        ResultSet rset = null;
        ResultSet rset1 = null;
        int rowsAffected = 0;
        int idShipping = 0;
        int active = 0;
        int idUser = 1;
        String driverName = "";
        String gate = "";
        String comments = "";
        String trailer = "";
        String trucking = "";
        String proforma = "";
        String sello = "";
        String loading = "";
        double quantity = 0;
        double weight = 0;
        String uom = "";
        String creationDate = "";
        String registrar = "";
        String line = "";
        String fechaLlegada = "";
        boolean boolSaveHistory = false;
        double invLinea = 0;
        double acumulado = 0;

        try {

            conn = this.GetSIDDataBase().GetConnection();
            conn.setAutoCommit(false);
            resultArray = new xmlNodeArray();

            if (GetNodeArray().existValue("idUser")) {
                idUser = GetNodeArray().find("idUser").getIntValue();
            }

            idShipping = GetNodeArray().find("idShipping").getIntValue();
            driverName = GetNodeArray().find("driverName").getStringValue();
            gate = GetNodeArray().find("gate").getStringValue();
            line = GetNodeArray().find("line").getStringValue();
            comments = GetNodeArray().find("comments").getStringValue();
            registrar = GetNodeArray().find("registrar").getStringValue();

            trucking = GetNodeArray().find("truckingtabla").getStringValue();
            trailer = GetNodeArray().find("trailertabla").getStringValue();
            proforma = GetNodeArray().find("proformatabla").getStringValue();
            sello = GetNodeArray().find("sellotabla").getStringValue();
            
            //select allowed pallet qty by line
            rset = pstmtSelectQtyAllowedByLine.executeQuery();
            if(rset.next()){
                QTY_ALLOWED = rset.getInt("Qty");
            }
            if(rset != null){
                rset.close();
                rset = null;
            }

            pstmtSelectShippingHistoryArrival.setInt(1, idShipping);
            rset = pstmtSelectShippingHistoryArrival.executeQuery();
            if (rset.next()) {
                fechaLlegada = rset.getString("ArrivalDate");
            }
            if (rset != null) {
                rset.close();
                rset = null;
            }

            if (registrar.equals("Arrive") || registrar.equals("Unloading")) {
                active = 1;
            }

            pstmtUpdatehippingInfo.setInt(1, active);
            pstmtUpdatehippingInfo.setString(2, gate);
            pstmtUpdatehippingInfo.setString(3, line);
            pstmtUpdatehippingInfo.setString(4, driverName);
            pstmtUpdatehippingInfo.setString(5, comments);
            pstmtUpdatehippingInfo.setInt(6, idShipping);
            rowsAffected = pstmtUpdatehippingInfo.executeUpdate();

            if (rowsAffected > 0) {
                boolSaveHistory = true;
            }

            if (boolSaveHistory) {
                if (registrar.equals("Arrive") || registrar.equals("Unloading")) {
                    pstmtInsertShippingHistoryArrival.setInt(1, idShipping);
                    pstmtInsertShippingHistoryArrival.setString(2, gate);
                    pstmtInsertShippingHistoryArrival.setString(3, driverName);
                    if (registrar.equals("Arrive")) {
                        pstmtInsertShippingHistoryArrival.setString(4, "LLegada");
                    } else {
                        pstmtInsertShippingHistoryArrival.setString(4, "Descargando");
                    }
                    pstmtInsertShippingHistoryArrival.setString(5, comments);
                    pstmtInsertShippingHistoryArrival.setString(6, line);
                    rowsAffected = pstmtInsertShippingHistoryArrival.executeUpdate();
                } else {
                    if (fechaLlegada.equals("")) {
                        //fechaLlegada = "now()";
                        pstmtInsertShippingHistory1.setInt(1, idShipping);
                        pstmtInsertShippingHistory1.setString(2, gate);
                        pstmtInsertShippingHistory1.setString(3, driverName);
                        pstmtInsertShippingHistory1.setString(4, "Recibido");
                        pstmtInsertShippingHistory1.setString(5, comments);
                        pstmtInsertShippingHistory1.setString(6, line);
                        rowsAffected = pstmtInsertShippingHistory1.executeUpdate();
                    } else {
                        pstmtInsertShippingHistory.setInt(1, idShipping);
                        pstmtInsertShippingHistory.setString(2, gate);
                        pstmtInsertShippingHistory.setString(3, driverName);
                        pstmtInsertShippingHistory.setString(4, "Recibido");
                        pstmtInsertShippingHistory.setString(5, comments);
                        pstmtInsertShippingHistory.setString(6, line);
                        pstmtInsertShippingHistory.setString(7, fechaLlegada);
                        rowsAffected = pstmtInsertShippingHistory.executeUpdate();
                    }

                    //CONSULTAR SI HAY ESPACIO EN LA LINEA ESCRITA
                    pstmtSelectTotalLine.setString(1, line);
                    rset = pstmtSelectTotalLine.executeQuery();
                    if (rset.next()) {
                        invLinea = rset.getDouble("Qty");
                    }

                    //INSERTAR EN INVENTARIO
                    String nomenclatura = "";
                    double totalembarque = 0;
                    for (int i = 1; i <= 44; i++) {
                        pstmtSelectTotalShipping.setInt(i, idShipping);
                    }
                    rset = pstmtSelectTotalShipping.executeQuery();
                    while (rset != null && rset.next()) {
                        nomenclatura = rset.getString(1);
                        totalembarque = rset.getDouble(2);

                        //Valida si hay producto
                        if (totalembarque > 0) {

                            //Valida los productos de 50..
                            if (nomenclatura.contains("50")) {
                                nomenclatura = nomenclatura.replace("50", "");
                                totalembarque = totalembarque / 45;
                                acumulado += totalembarque / 45;
                            } else if (nomenclatura.contains("25")) {
                                totalembarque = totalembarque / 90;
                                acumulado += totalembarque / 90;
                            } else if (nomenclatura.contains("40")) {
                                totalembarque = totalembarque / 42;
                                acumulado += totalembarque / 42;
                            } else {
                                acumulado += totalembarque;
                            }

//                            //Valida los productos de 25..
//                            if (nomenclatura.contains("25")) {
//                                totalembarque = totalembarque / 90;
//                            }
//
//                            //Valida los productos de 40..
//                            if (nomenclatura.contains("40")) {
//                                totalembarque = totalembarque / 42;
//                            }
                            //INSERTAR EN INVENTARIO
                            int idInventario = 0;
                            double totalInventario = 0;
                            pstmtSelectInventory.setString(1, line);
                            pstmtSelectInventory.setString(2, nomenclatura);
                            pstmtSelectInventory.setString(3, proforma);
                            rset1 = pstmtSelectInventory.executeQuery();
                            if (rset1.next()) {
                                idInventario = rset1.getInt("id");
                                totalInventario = rset1.getDouble("Qty");
                            }

                            if (totalInventario > 0) {
                                //Editar inventario
                                pstmtEditInventory.setDouble(1, totalembarque);
                                pstmtEditInventory.setInt(2, idInventario);
                                rowsAffected = pstmtEditInventory.executeUpdate();

                            } else {
                                //Insertar inventario
                                pstmtInsertInventory.setString(1, nomenclatura);
                                pstmtInsertInventory.setDouble(2, totalembarque);
                                pstmtInsertInventory.setString(3, line);
                                pstmtInsertInventory.setString(4, proforma);
                                rowsAffected = pstmtInsertInventory.executeUpdate();
                            }

                            //Insertar historial inventario
                            pstmtInsertInventoryHistory.setString(1, proforma);
                            pstmtInsertInventoryHistory.setString(2, trucking);
                            pstmtInsertInventoryHistory.setString(3, trailer);
                            pstmtInsertInventoryHistory.setString(4, line);
                            pstmtInsertInventoryHistory.setString(5, gate);
                            pstmtInsertInventoryHistory.setString(6, driverName);
                            pstmtInsertInventoryHistory.setString(7, sello);
                            pstmtInsertInventoryHistory.setInt(8, idUser);
                            pstmtInsertInventoryHistory.setString(9, comments);
                            pstmtInsertInventoryHistory.setString(10, nomenclatura);
                            pstmtInsertInventoryHistory.setDouble(11, totalembarque);
                            rowsAffected = pstmtInsertInventoryHistory.executeUpdate();
                        }
                    }
                }

                //VALIDAR SI ESTA HABILITADA LA OPCION DE DESCONTAR DE INVENTARIO Y VER SI VALIDAMOS CANTIDAD DE PALLETS
                int discount = 0;
                rset = pstmtSelectDiscountInventory.executeQuery();
                if (rset.next()) {
                    discount = rset.getInt("Active");
                }

                if (rowsAffected > 0 && (invLinea + acumulado) > QTY_ALLOWED && discount > 0) {
                    conn.rollback();
                    resultArray.add("error", "The line " + line + " cannot store more pallets.");
                    resultArray.add("RESPONSE_CODE", "FAIL");
                    resultArray.add("RESPONSE_MESSAGE", "The line " + line + " cannot store more pallets.");
                    resultArray.add("RESPONSE_DETAIL", "");
                } else if (rowsAffected > 0) {
                    conn.commit();
                    resultArray.add("RESPONSE_CODE", "PASS");
                    resultArray.add("RESPONSE_MESSAGE", "El embarque ha sido registrado exitosamente.");
                    resultArray.add("RESPONSE_DETAIL", "");
                } else {
                    conn.rollback();
                    resultArray.add("error", "El embarque no pudo ser registrado.");
                    resultArray.add("RESPONSE_CODE", "FAIL");
                    resultArray.add("RESPONSE_MESSAGE", "El embarque no pudo ser registrado.");
                    resultArray.add("RESPONSE_DETAIL", "");
                }

            }

            return resultArray;
        } catch (SQLException e) {
            conn.rollback();
            System.out.println("CloseShippingTransaction::Execute> SQLException: " + e.getMessage());
            resultArray = new xmlNodeArray();
            resultArray.add("RESPONSE_CODE", "FAIL");
            resultArray.add("RESPONSE_MESSAGE", "SQLException:" + e.getMessage());
            resultArray.add("RESPONSE_DETAIL", e.getMessage());
            return resultArray;
        } catch (Exception ex) {
            conn.rollback();
            System.out.println("CloseShippingTransaction::Execute> Exception: " + ex.getMessage());
            resultArray = new xmlNodeArray();
            resultArray.add("RESPONSE_CODE", "FAIL");
            resultArray.add("RESPONSE_MESSAGE", "Exception:" + ex.getMessage());
            resultArray.add("RESPONSE_DETAIL", ex.getMessage());
            return resultArray;
        } finally {
            CloseStatements();
//            System.out.println("<CloseShippingTransaction::Execute> exit");
        }
    }

    /**
     * Generates an xmlNodeArray containing parameters for this transaction
     *
     * @return xmlNodeArray that contains parameters for the transaction
     * @exception (none)
     */
    @Override
    public xmlNodeArray GenerateTestParameters() {
        xmlNodeArray nodeArr = new xmlNodeArray();
        nodeArr.add("TRANSACTION_CLASS_TO_EXECUTE", "JonesPlasticTransactions.CloseShippingTransaction");

        return nodeArr;

    }

    /**
     * The main method for the transaction. Creates a database connection and an
     * error Array, then executes the transaction and reports any errors
     *
     * @param argv argv[0] is an optional configuration file name
     * @exception (none)
     */
    public static void main(String[] argv) {
        try {
            CloseShippingTransaction transaction = new CloseShippingTransaction();
            SIDWebTransaction resultTransaction = null;
            xmlNodeArray inputParameterArray = null;
            //CIMDataBase database = null;
            System.out.println("Usage: java -classpath ...JonesPlasticTransactions.CloseShippingTransaction");

            //<Add Database connection parameter for testing>
            database = new SIDDataBase("jdbc:mysql://www.sidchihuahua.com:3306/zodiac", "zodiac_admin", "Z0d14c#4");

            transaction.SetSIDDataBase(database);
            inputParameterArray = transaction.GenerateTestParameters();
            if (!transaction.IsValidTransaction()) {
                System.out.println(" CloseShippingTransaction contains an invalid transaction type.");
            } else {
                if (!transaction.Supports(inputParameterArray)) {
                    System.out.println(" CloseShippingTransaction does not support this list of parameters.");
                } else {
                    resultTransaction = database.ExecuteTransaction("JonesPlasticTransactions.CloseShippingTransaction", inputParameterArray);
                    if (resultTransaction == null) {
                        System.out.println("The transaction's result array is null.");
                    } else {
                        if (resultTransaction.GetError() != null) {
                            resultTransaction.GetError().print();
                        } else {
                            if (resultTransaction.GetResultArray() == null) {
                                System.out.println("CloseShippingTransaction - No results were returned.");
                            } else {
                                xmlNodeArray array = resultTransaction.GetResultArray();
                                String str = xmlNodeArray.xmlNodeArray2String(array);
                                array = xmlNodeArray.string2xmlNodeArray(str);
                                System.out.println(str);
                            }
                        }
                    }
                }
            }
        } catch (Exception e) {
            System.out.println("CloseShippingTransaction::main> caught exception " + e.getMessage());
            e.printStackTrace();
        }
    }
}
