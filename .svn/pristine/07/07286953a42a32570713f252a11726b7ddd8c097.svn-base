package Agrocosa;

import SIDWebEngine.SIDServlet;
import java.io.IOException;
import javax.servlet.*;
import javax.servlet.http.*;
import xmlNodeArray.xmlNodeArray;

public class MainServlet extends SIDServlet {

    String newTaskQtyTxn = "AgrocosaTransactions.RetrieveNewTaskQtyTransaction";

    @Override
    protected void processRequest(HttpServletRequest request,
            HttpServletResponse response,
            xmlNodeArray nodeArray) {
        RequestDispatcher rd = null;
        HttpSession session = null;
        xmlNodeArray callTxnNA = null;
        xmlNodeArray txnNA = null;

        try {
            session = request.getSession();
            callTxnNA = new xmlNodeArray();
            callTxnNA.add("TRANSACTION_CLASS_TO_EXECUTE", newTaskQtyTxn);
            callTxnNA.add("idUser", session.getAttribute("idUser").toString());
            callTxnNA.add("rol", session.getAttribute("rol").toString());
            callTxnNA.append(nodeArray);

            //Employees by Month
            txnNA = executeTransaction(callTxnNA);
            if (txnNA != null) {
                request = this.parseTxnResponse(request, txnNA);

                if (session.getAttribute("rol").toString().equals("Administrador")) {
                    session.setAttribute("NewFarmingQty", request.getAttribute("NewLabranzaQty"));
                    session.setAttribute("NewJournalQty", request.getAttribute("NewJornalQty"));
                    session.setAttribute("NewIrrigationQty", request.getAttribute("NewRiegoQty"));
                    session.setAttribute("NewPickingQty", request.getAttribute("NewCosechaQty"));
                    session.setAttribute("NewApplicationQty", request.getAttribute("NewAplicacion FoliarQty"));                    
                } else {
                    session.setAttribute("NuevaQty", request.getAttribute("NuevaQty"));
                    session.setAttribute("EnProcesoQty", request.getAttribute("EnProcesoQty"));
                }
            }
            rd = request.getRequestDispatcher("/main.page");

            rd.forward(request, response);
        } catch (IOException ioe) {
            if (session != null) {
                session.setAttribute("error",
                        "IO_EXCEPTION_ERROR" + ". " + "<" + this.getClass().getName()
                        + ": processRequest> IOException: "
                        + ioe.getMessage());
            }
        } catch (ServletException se) {
            if (session != null) {
                session.setAttribute("error",
                        "SERVLET_EXCEPTION_ERROR" + ". " + "<" + this.getClass().getName()
                        + ": processRequest> ServletException: "
                        + se.getMessage());
            }
        }
    }
}
