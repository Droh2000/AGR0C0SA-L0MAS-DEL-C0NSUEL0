package AgrocosaTransactions;

import SIDWebEngine.*;
import java.sql.*;
import xmlNodeArray.*;

public class CloseDeliveryTransaction extends SIDWebTransaction {

    protected PreparedStatement pstmtDeliveryInfo;
    protected PreparedStatement pstmtUpdateDeliveryInfo;
    protected PreparedStatement pstmtInsertDeliveryHistory;

    /**
     * Default Constructor
     *
     * @exception (none)
     */
    public CloseDeliveryTransaction() {
        super();
        SetTransactionType(SIDWebTransaction.SaveType);
    }

    /**
     * Checks to see if the node Array is supported
     *
     * @param nodeArray
     * @return <B>true</B> if the nodeArray is supported. <B>false</B> otherwise
     * @exception (none)
     */
    @Override
    public boolean Supports(xmlNodeArray nodeArray) {

        //Add tag names as comma separated Strings to the mandatoryTags array
        String[] mandatoryTags = {
            "idDelivery",
            "driverName",
            "driverTel",
            "trucking",
            "trailerType"
        };

        //Add tag names as comma separated Strings to the optionalTags array
        String[] optionalTags = {};
        //Add tag names as comma separated Strings to the mandatorySets array
        String[] mandatorySets = {};
        //Add tag names as comma separated Strings to the optionalSetTags array
        String[] optionalSets = {};

        xmlNodeArray errArray = new xmlNodeArray();
        for (int i = 0; i < mandatoryTags.length; i++) {
            if (!nodeArray.existValue(mandatoryTags[i])) {
                System.out.println("<CloseDeliveryTransaction::Supports> " + mandatoryTags[i] + " Mandatory tag not found or value is empty/null");
                errArray.add("ERROR", "MANDATORY_TAG_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < optionalTags.length; i++) {
            if (nodeArray.exist(optionalTags[i]) && !nodeArray.existValue(optionalTags[i])) {
                System.out.println("<CloseDeliveryTransaction::Supports> " + optionalTags[i] + " Optional tag not found or value is empty/null");
                errArray.add("OPTIONAL_TAG_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < mandatorySets.length; i++) {
            if (nodeArray.find(mandatorySets[i]) == null || nodeArray.find(mandatorySets[i]).getTable() == null || nodeArray.find(mandatorySets[i]).getTable().getRowsQty() == 0) {
                System.out.println("<CloseDeliveryTransaction::Supports> " + mandatorySets[i] + " Mandatory Set not found or value is empty/null");
                errArray.add("MANDATORY_SET_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < optionalSets.length; i++) {
            if (nodeArray.find(mandatorySets[i]) != null && (nodeArray.find(mandatorySets[i]).getTable() == null || nodeArray.find(mandatorySets[i]).getTable().getRowsQty() == 0)) {
                System.out.println("<CloseDeliveryTransaction::Supports> " + optionalSets[i] + " Optional Set not found or value is empty/null");
                errArray.add("OPTIONAL_SET_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        return true;
    }

    /**
     * Prepares the SQL statements to be executed
     *
     * @return <B>true</B> for successful preparation; <B>false</B> for
     * unsuccessful preparation
     * @exception (none)
     */
    @Override
    public synchronized boolean PrepareStatements() {
        //Note1 : Use PreparedStatements instead of Statements where ever possible
        //Note2 : If transaction contains no prepared statements, delete entire function
        //        Unless there are nested transaction, then Prepare will call those.
        try {
            Connection con = this.GetSIDDataBase().GetConnection();

            pstmtDeliveryInfo = con.prepareStatement("select *, "
                    + "date_format(CreationDate,'%d/%m/%Y') as fCreationDate "
                    + "from deliveryhistory "
                    + "where idDelivery = ? "
                    + "and Status  = 'Nueva' ");
            
            pstmtUpdateDeliveryInfo = con.prepareStatement("update delivery set "
                    + "DevlieryDate = Now(), "
                    + "TrailerType = ?, "
                    + "Trucking = ?, "
                    + "DriverName = ?, "
                    + "DriverTel = ?, "
                    + "Status = 'Entregado', "
                    + "ModifiedDate = now() "
                    + "Where idDelivery = ? "
                    + "and Active = 1");

            pstmtInsertDeliveryHistory = con.prepareStatement("insert into deliveryhistory ( "
                    + "idDelivery, "
                    + "PickupNumber, "
                    + "Description, "
                    + "Quantity, "
                    + "Weight, "
                    + "UOM, "
                    + "CreationDate, "
                    + "DeliveryDate, "
                    + "TrailerType, "
                    + "Trucking, "
                    + "DriverName, "
                    + "DriverTel, "
                    + "Status, "
                    + "Comments, "
                    + "InsertDate "
                    + ") values( "
                    + "?, "//1 idDelivery
                    + "?, "//2 PickupNumber
                    + "?, " //3 Description
                    + "?, " //4 Quantity
                    + "?, " //5 Weight
                    + "?, " //6 UOM
                    + "STR_TO_DATE(?,'%d/%m/%Y'), " //7 CreationDate
                    + "now(), " // DeliveryDate
                    + "?, "//8 TtrailerType
                    + "?, "//9 Trucking
                    + "?, "//10 DriverName
                    + "?, "//11 DriverTel
                    + "?, "//12 Status
                    + "?, "//13 Comments
                    + "Now() " //InsertDate
                    + ")");

            this.addPreparedStatement(pstmtDeliveryInfo);
            this.addPreparedStatement(pstmtUpdateDeliveryInfo);
            this.addPreparedStatement(pstmtInsertDeliveryHistory);

            return true;
        } catch (SQLException e) {
            System.out.println("CloseDeliveryTransaction::PrepareStatements> SQLException: " + e.getMessage());
            return false;
        }
    }

    /**
     * executes sql statements using input arguments and returns result
     *
     * @return valid node array if successful else null
     * @exception SQLException if sql error occurs
     * @exception Exception if non sql error occurs
     */
    @Override
    public synchronized xmlNodeArray Execute() throws SQLException, Exception {
        Connection conn = null;
        xmlNodeArray resultArray = null;
        ResultSet rset = null;
        int rowsAffected = 0;
        int idDelivery = 0;
        String driverName = "";
        String driverTel = "";
        String trailerType = "";
        String trucking = "";
        String comments = "";
        double quantity = 0;
        double weight = 0;
        String uom = "";
        String creationDate = "";
        boolean boolSaveHistory = false;
        String pickupNumber = "";
        String description = "";

        try {

            conn = this.GetSIDDataBase().GetConnection();
            conn.setAutoCommit(false);
            resultArray = new xmlNodeArray();

            idDelivery = GetNodeArray().find("idDelivery").getIntValue();
            driverName = GetNodeArray().find("driverName").getStringValue();
            driverTel = GetNodeArray().find("driverTel").getStringValue();
            trailerType = GetNodeArray().find("trailerType").getStringValue();
            trucking = GetNodeArray().find("trucking").getStringValue();
            comments = GetNodeArray().find("comments").getStringValue();

            pstmtDeliveryInfo.setInt(1, idDelivery);
            rset = pstmtDeliveryInfo.executeQuery();
            if (rset.next()) {
                pickupNumber = rset.getString("PickupNumber");
                description = rset.getString("Description");
                quantity = rset.getDouble("Quantity");
                weight = rset.getDouble("Weight");
                uom = rset.getString("UOM");
                creationDate = rset.getString("fCreationDate");
            }
            if (rset != null) {
                rset.close();
                rset = null;
            }

            pstmtUpdateDeliveryInfo.setString(1, trailerType);
            pstmtUpdateDeliveryInfo.setString(2, trucking);
            pstmtUpdateDeliveryInfo.setString(3, driverName);
            pstmtUpdateDeliveryInfo.setString(4, driverTel);
            pstmtUpdateDeliveryInfo.setInt(3, idDelivery);
            rowsAffected = pstmtUpdateDeliveryInfo.executeUpdate();
            if (rowsAffected > 0) {
                boolSaveHistory = true;
            }

            if (boolSaveHistory) {
                pstmtInsertDeliveryHistory.setInt(1, idDelivery);
                pstmtInsertDeliveryHistory.setString(2, pickupNumber);
                pstmtInsertDeliveryHistory.setString(3, description);
                pstmtInsertDeliveryHistory.setDouble(4, quantity);
                pstmtInsertDeliveryHistory.setDouble(5, weight);
                pstmtInsertDeliveryHistory.setString(6, uom);
                pstmtInsertDeliveryHistory.setString(7, creationDate);
                pstmtInsertDeliveryHistory.setString(8, trailerType);
                pstmtInsertDeliveryHistory.setString(9, trucking);
                pstmtInsertDeliveryHistory.setString(10, driverName);
                pstmtInsertDeliveryHistory.setString(11, driverTel);
                pstmtInsertDeliveryHistory.setString(12, "Recibido");
                pstmtInsertDeliveryHistory.setString(13, comments);
                rowsAffected = pstmtInsertDeliveryHistory.executeUpdate();

                if (rowsAffected > 0) {
                    conn.commit();
                    resultArray.add("RESPONSE_CODE", "PASS");
                    resultArray.add("RESPONSE_MESSAGE", "La entrega ha sido registrado exitosamente.");
                    resultArray.add("RESPONSE_DETAIL", "");
                } else {
                    conn.rollback();
                    resultArray.add("error", "La entrega no pudo ser registrada.");
                    resultArray.add("RESPONSE_CODE", "FAIL");
                    resultArray.add("RESPONSE_MESSAGE", "La entrega no pudo ser registrada.");
                    resultArray.add("RESPONSE_DETAIL", "");
                }

            }

            return resultArray;
        } catch (SQLException e) {
            conn.rollback();
            System.out.println("CloseDeliveryTransaction::Execute> SQLException: " + e.getMessage());
            resultArray = new xmlNodeArray();
            resultArray.add("RESPONSE_CODE", "FAIL");
            resultArray.add("RESPONSE_MESSAGE", "SQLException:" + e.getMessage());
            resultArray.add("RESPONSE_DETAIL", e.getMessage());
            return resultArray;
        } catch (Exception ex) {
            conn.rollback();
            System.out.println("CloseDeliveryTransaction::Execute> Exception: " + ex.getMessage());
            resultArray = new xmlNodeArray();
            resultArray.add("RESPONSE_CODE", "FAIL");
            resultArray.add("RESPONSE_MESSAGE", "Exception:" + ex.getMessage());
            resultArray.add("RESPONSE_DETAIL", ex.getMessage());
            return resultArray;
        } finally {
            CloseStatements();
//            System.out.println("<CloseDeliveryTransaction::Execute> exit");
        }
    }

    /**
     * Generates an xmlNodeArray containing parameters for this transaction
     *
     * @return xmlNodeArray that contains parameters for the transaction
     * @exception (none)
     */
    @Override
    public xmlNodeArray GenerateTestParameters() {
        xmlNodeArray nodeArr = new xmlNodeArray();
        nodeArr.add("TRANSACTION_CLASS_TO_EXECUTE", "JonesPlasticTransactions.CloseDeliveryTransaction");

        return nodeArr;

    }

    /**
     * The main method for the transaction. Creates a database connection and an
     * error Array, then executes the transaction and reports any errors
     *
     * @param argv argv[0] is an optional configuration file name
     * @exception (none)
     */
    public static void main(String[] argv) {
        try {
            CloseDeliveryTransaction transaction = new CloseDeliveryTransaction();
            SIDWebTransaction resultTransaction = null;
            xmlNodeArray inputParameterArray = null;
            //CIMDataBase database = null;
            System.out.println("Usage: java -classpath ...JonesPlasticTransactions.CloseDeliveryTransaction");

            //<Add Database connection parameter for testing>
            database = new SIDDataBase("jdbc:mysql://www.sidchihuahua.com:3306/zodiac", "zodiac_admin", "Z0d14c#4");

            transaction.SetSIDDataBase(database);
            inputParameterArray = transaction.GenerateTestParameters();
            if (!transaction.IsValidTransaction()) {
                System.out.println(" CloseDeliveryTransaction contains an invalid transaction type.");
            } else {
                if (!transaction.Supports(inputParameterArray)) {
                    System.out.println(" CloseDeliveryTransaction does not support this list of parameters.");
                } else {
                    resultTransaction = database.ExecuteTransaction("JonesPlasticTransactions.CloseDeliveryTransaction", inputParameterArray);
                    if (resultTransaction == null) {
                        System.out.println("The transaction's result array is null.");
                    } else {
                        if (resultTransaction.GetError() != null) {
                            resultTransaction.GetError().print();
                        } else {
                            if (resultTransaction.GetResultArray() == null) {
                                System.out.println("CloseDeliveryTransaction - No results were returned.");
                            } else {
                                xmlNodeArray array = resultTransaction.GetResultArray();
                                String str = xmlNodeArray.xmlNodeArray2String(array);
                                array = xmlNodeArray.string2xmlNodeArray(str);
                                System.out.println(str);
                            }
                        }
                    }
                }
            }
        } catch (Exception e) {
            System.out.println("CloseDeliveryTransaction::main> caught exception " + e.getMessage());
            e.printStackTrace();
        }
    }
}
