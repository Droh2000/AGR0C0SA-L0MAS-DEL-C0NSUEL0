<%@ taglib uri="http://displaytag.sf.net" prefix="display"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<!-- daterange picker -->
<link href="../plugins/daterangepicker/daterangepicker-bs3.css" rel="stylesheet" type="text/css" />



<div class="" >
    <div style="content-wrapper">
        <section class="content-header">
            <h1>
                Reporte de Historial de Embarques
                <small>Consulta de hsitorial de embarques</small>
            </h1>
        </section>

        <!-- Main content -->
        <section class="content">

            <c:choose>
                <c:when test="${requestScope.RESPONSE_CODE == 'PASS'}">                    
                    <c:if test="${requestScope.RESPONSE_MESSAGE ne 'OK'}">


                        <div class="alert alert-success alert-dismissable">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                            <h4>	<i class="icon fa fa-check"></i> OK</h4>
                            <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                            <c:out value="${requestScope.RESPONSE_DETAIL}" />
                        </div>
                    </c:if>
                </c:when>
                <c:when test="${requestScope.RESPONSE_CODE == 'FAIL'}">
                    <div class="alert alert-danger alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <h4><i class="icon fa fa-ban"></i> Error !</h4>
                        <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                        <c:out value="${requestScope.RESPONSE_DETAIL}" />
                    </div>

                </c:when>
            </c:choose>

            <!-- Search Meeting -->
            <form name="formSearch" role="form" action="shippingHistoryReport.do" method="post">
                <div class="box box-success">
                    <div class="box-header with-border">
                        <h3 class="box-title">Filtros de Busqueda</h3>
                        <div class="box-tools pull-right">
                            <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                        </div>                    
                    </div><!-- /.box-header -->
                    <div class="box-body">
                        <div class='row'>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label >Numero:</label>
                                    <input class="form-control" placeholder="idShipping" type="text" data-title="No puede estar vacio" name="idShipping" size ="5" value="${requestScope.SelectedIdShipping}"/>
                                </div><!-- /.form-group -->
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label >Trucking:</label>
                                    <input class="form-control" placeholder="trucking" type="text" data-title="No puede estar vacio" name="trucking" size ="5" value="${requestScope.SelectedTrucking}"/>
                                </div><!-- /.form-group -->
                            </div>                            
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label >Estatus:</label>
                                    <select name="status" id="status" class="form-control" data-title="Estatus">
                                        <option value=""></option>
                                        <option value="Embarcado"  ${requestScope.SelectedStatus == 'Embarcado'  ? 'selected' : ''}>Embarcado</option>
                                        <option value="Eliminado"  ${requestScope.SelectedStatus == 'Eliminado'  ? 'selected' : ''}>Eliminado</option>
                                        <option value="Modificado"  ${requestScope.SelectedStatus == 'Modificado'  ? 'selected' : ''}>Modificado</option>
                                        <option value="Recibido"  ${requestScope.SelectedStatus == 'Recibido'  ? 'selected' : ''}>Recibido</option>
                                    </select>                                    
                                </div><!-- /.form-group -->
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label >Fecha de Recibo (inicio):</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" name="startDate" class="form-control" id="startDate" value="${requestScope.SelectedStartDate}"/>
                                    </div>
                                </div><!-- /.form-group -->
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label >Fecha de Recibo (fin):</label>
                                    <div class="input-group">
                                        <div class="input-group-addon">
                                            <i class="fa fa-calendar"></i>
                                        </div>
                                        <input type="text" name="endDate" class="form-control" id="endDate" value="${requestScope.SelectedEndDate}"/>
                                    </div> 
                                </div><!-- /.form-group -->
                            </div>
                        </div>

                    </div><!-- /.box-body -->
                    <div class="box-footer">
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary"><i class="fa fa-search"></i> Buscar</button>
                            <input type="hidden" name="Action" value="Search"/>
                        </div><!-- /.form-group -->                        
                    </div>
                </div><!-- /.box -->
            </form>


            <c:if test="${requestScope.ShippingHistoryReport_Table ne null}">

                <div class="box box-success">
                    <div class="box-header with-border">
                        <h3 class="box-title"> Historial de Embarques</h3>
                        <div class="box-tools pull-right">
                            <div class="pull-left"></div>                        
                            <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                        </div>
                    </div><!-- /.box-header -->
                    <div class="box-body">
                        <div class="table-responsive">
                            <table id="dtable" class="table table-bordered table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th>Numero</th>                                    
                                        <th>Trailer</th>                                    
                                        <th>Trucking</th>
                                        <th>Carga</th>
                                        <th>Cantidad</th>
                                        <th>Peso</th>
                                        <th>Unidad de Medida</th>                                    
                                        <th>Rampa</th>                                    
                                        <th>Nombre de Chofer</th>                                    
                                        <th>Estatus</th>                                    
                                        <th>Fecha de Creacion</th>                                    
                                        <th>Fecha de Recibo</th>                                    
                                        <th>Comentarios</th>                                    
                                    </tr>
                                </thead>
                                <tbody>
                                    <c:forEach items="${ShippingHistoryReport_Table}" var="row" varStatus="status">
                                        <tr>
                                            <td>${row.idShipping}</td>
                                            <td>${row.Trailer}</td>
                                            <td>${row.Trucking}</td>                                        
                                            <td>${row.Loading}</td>
                                            <td>${row.Quantity}</td>
                                            <td>${row.Weight}</td>
                                            <td>${row.UOM}</td>
                                            <td>${row.Gate}</td>                                        
                                            <td>${row.DriverName}</td>                                        
                                            <td>${row.Status}</td>                                        
                                            <td>${row.CreationDate}</td>                                        
                                            <td>${row.ReceiptDate}</td>                                        
                                            <td>${row.Comments}</td>                                        
                                        </tr>
                                    </c:forEach>
                                </tbody>
                            </table> 
                        </div>
                    </div><!-- /.box-body -->
                    <div class="box-footer"></div>
                </div>
            </c:if>        

            <script>
                $('#dtable').DataTable({
                    "paging": false,
                    "lengthChange": false,
                    "searching": true,
                    "ordering": false,
                    "info": false,
                    "autoWidth": false,
                    "dom": 'lfrtip',
                    "tableTools": {
                        "sSwfPath": "../plugins/datatables/extensions/TableTools/swf/copy_csv_xls_pdf.swf"
                    }
                });

            </script>
            

            <!-- date-range-picker -->
            <script src="../plugins/daterangepicker/moment.min.js" type="text/javascript"></script>
            <script src="../plugins/daterangepicker/daterangepicker.js" type="text/javascript"></script>


            <script>
                            $(function () {

                                //startDate
                                $('#startDate').daterangepicker({
                                    singleDatePicker: true,
                                    format: 'DD/MM/YYYY',
                                    drops: 'auto',
                                    locale: {
                                        daysOfWeek: [
                                            "Do",
                                            "Lu",
                                            "Ma",
                                            "Mi",
                                            "Ju",
                                            "Vi",
                                            "Sa"
                                        ],
                                        monthNames: [
                                            "Enero",
                                            "Febrero",
                                            "Marzo",
                                            "Abril",
                                            "Mayo",
                                            "Junio",
                                            "Julio",
                                            "Agosto",
                                            "Septiembre",
                                            "Octubre",
                                            "Noviembre",
                                            "Diciembre"
                                        ]
                                    }
                                });
                                //endDate
                                $('#endDate').daterangepicker({
                                    singleDatePicker: true,
                                    format: 'DD/MM/YYYY',
                                    drops: 'up',
                                    locale: {
                                        daysOfWeek: [
                                            "Do",
                                            "Lu",
                                            "Ma",
                                            "Mi",
                                            "Ju",
                                            "Vi",
                                            "Sa"
                                        ],
                                        monthNames: [
                                            "Enero",
                                            "Febrero",
                                            "Marzo",
                                            "Abril",
                                            "Mayo",
                                            "Junio",
                                            "Julio",
                                            "Agosto",
                                            "Septiembre",
                                            "Octubre",
                                            "Noviembre",
                                            "Diciembre"
                                        ]
                                    }
                                });
                            });


            </script>


            <c:if test="false">
                <c:forEach items='${requestScope}' var='p'>
                    <ul>
                        <%-- Display the key of the current item, which
                             represents the parameter name --%>
                        <li>Parameter Name: <c:out value='${p.key}'/></li>

                        <%-- Display the value of the current item, which
                             represents the parameter value --%>
                        <li>Parameter Value: <c:out value='${p.value}'/></li>
                    </ul>
                </c:forEach>
            </c:if>
        </section><!-- /.content -->
    </div><!-- /.content-wrapper -->
</div>