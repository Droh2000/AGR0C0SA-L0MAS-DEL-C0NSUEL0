<%@ taglib uri="http://displaytag.sf.net" prefix="display"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
<!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
<![endif]-->
<link rel="stylesheet" href="../plugins/iCheck/all.css">

<script type="text/javascript">

    function radio(clicked) {
        var form = clicked.form;
        var checkboxes = form.elements[clicked.name];

        //alert(checkboxes.length);
        if (!clicked.checked) {
            clicked.parentNode.parentNode.className = "";
            return false;
        }

        for (i = 0; i < checkboxes.length; i++) {
            if (checkboxes[i] !== clicked) {
                checkboxes[i].checked = false;
                checkboxes[i].parentNode.parentNode.className = "";
            }
        }

        // highlight the row
        clicked.parentNode.parentNode.className = "over";
    }

    function validateSelectedItem()
    {
        for (i = 0; i < document.paramsForm.elements.length; i++)
        {
            if (document.paramsForm.elements[i].type === "checkbox")
            {
                if (document.paramsForm.elements[i].checked)
                    return true;
            }
        }
        alert('Por favor seleccione un registro para utilizar esta opcion.');
        return false;
    }

    function confirmSave()
    {
        var answer = confirm("Esta usted seguro de querer guardar este registro?");
        if (answer)
        {
            return true;
        } else {
            return false;
        }
    }

    function checkIt(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57))
        {
            //status = "This field accepts numbers only.";
            return false;
        }
        return true;
    }
    function confirmDelete()
    {
        if (validateSelectedItem())
        {
            var answer = confirm("Esta usted seguro de eliminar este registro?");
            if (answer)
                return true;
            else
                return false;
        }
        else
            return false;
    }

    function addCropType(idAgrochemical)
    {

        $('#selectedIdAgrochemical').val(idAgrochemical);
        $('#frmAddCropType').submit();

    }

</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Administración de Agroquimicos
            <small>Configuración de Agroquimicos</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-caret-right"></i> Configuración</a></li>
            <li class="active">Aqui</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">

        <c:choose>
            <c:when test="${requestScope.RESPONSE_CODE == 'PASS'}">                    
                <c:if test="${requestScope.RESPONSE_MESSAGE ne 'OK'}">


                    <div class="alert alert-success alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <h4>	<i class="icon fa fa-check"></i> OK</h4>
                        <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                        <c:out value="${requestScope.RESPONSE_DETAIL}" />
                    </div>
                </c:if>
            </c:when>
            <c:when test="${requestScope.RESPONSE_CODE == 'FAIL'}">
                <div class="alert alert-danger alert-dismissable">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h4><i class="icon fa fa-ban"></i> Error !</h4>
                    <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                    <c:out value="${requestScope.RESPONSE_DETAIL}" />
                </div>

            </c:when>
        </c:choose>

        <form name="paramsForm" method="POST" action="agrochemicalManagement.do"  onsubmit="">
            <div class="box box-success">
                <div class="box-header with-border">
                    <h3 class="box-title">Agroquimicos</h3>
                </div>


                <div class="box-body" id="info" > 
                    <c:forEach items="${AgrochemicalInfo_Table}" var="row" varStatus="status">
                        <c:choose>
                            <c:when test="${requestScope.Method == 'Edit' and requestScope.ID == row.idAgrochemical}">
                                <div class="row">


                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Nombre de Agroquimico</label>                                                
                                            <div class="input-group">
                                                <input name="AgrochemicalName" type="text" class="form-control pull-right" id="AgrochemicalName" required value="${row.AgrochemicalName}" />
                                            </div>                                  
                                        </div>
                                        <div class="form-group">
                                            <label>Casa Comercial</label>                                                
                                            <div class="input-group">
                                                <input name="Brand" type="text" class="form-control pull-right" id="Brand" required value="${row.Brand}" />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>Ingrediente Activo</label>                                                
                                            <div class="input-group">  
                                                <input name="ActiveIngredient" type="text" class="form-control pull-right" id="ActiveIngredient" required value="${row.ActiveIngredient}" />
                                            </div>
                                        </div>                                        
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label >Unidad de Medida</label>
                                            <select name="UOM" id="UOM" class="form-control" data-title="Unida de Medida" required>
                                                <option value=""></option>
                                                <c:forEach items="${UOM_HashMap}" var="item">
                                                    <option value="${item.value}"  ${row.UOM == item.value  ? 'selected' : ''}>${item.value}</option>
                                                </c:forEach>
                                            </select>                                 
                                        </div><!-- /.form-group -->
                                        <div class="form-group">
                                            <label >Tipo de Agroquimico</label>
                                            <select name="AgrochemicalType" id="AgrochemicalType" class="form-control" data-title="Tipo de Agroquimico" required>
                                                <option value=""></option>
                                                <c:forEach items="${AgrochemicalType_HashMap}" var="item">
                                                    <option value="${item.value}"  ${row.AgrochemicalType == item.value  ? 'selected' : ''}>${item.value}</option>
                                                </c:forEach>
                                            </select>                                 
                                        </div><!-- /.form-group -->
                                        <div class="form-group">
                                            <label>Dosis Minima</label>                                                
                                            <div class="input-group">
                                                <input name="MinDose" type="text" class="form-control pull-right" id="MinDose" required value="${row.MinDose}" />
                                            </div>                                  
                                        </div>                                         
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Dosis Maxima</label>                                                
                                            <div class="input-group">
                                                <input name="MaxDose" type="text" class="form-control pull-right" id="MaxDose" required value="${row.MaxDose}" />
                                            </div>                                  
                                        </div>                                         
                                        <div class="form-group">
                                            <label >Intervalo de Seguridad</label>
                                            <div class="input-group">
                                                <input name="SecurityInterval" type="text" class="form-control pull-right" id="SecurityInterval" required value="${row.SecurityInterval}" />
                                            </div>                                  
                                        </div><!-- /.form-group -->
                                        <div class="form-group">
                                            <label >Periodo de Retardo</label>
                                            <div class="input-group">
                                                <input name="DelayPeriod" type="text" class="form-control pull-right" id="DelayPeriod" required value="${row.DelayPeriod}" />
                                            </div>                                  
                                        </div><!-- /.form-group -->
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label>Registrado Por</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-user"></i>
                                                </div>
                                                <input type="text" name="User" id="User" class="form-control" value="${row.User}" readonly />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>Fecha de Registro</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                                <input type="text" name="InsertDate" id="InsertDate" class="form-control" value="${row.InsertDate}" readonly />
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <label>Fecha de Modificación</label>
                                            <div class="input-group">
                                                <div class="input-group-addon">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                                <input type="text" name="ModifiedDate" id="ModifiedDate" class="form-control" value="${row.ModifiedDate}" readonly />
                                            </div>                                
                                        </div>
                                    </div>

                                </div>
                                <input type="hidden" name="ID" title="${row.idAgrochemical}" value="${row.idAgrochemical}"/>
                            </c:when>
                        </c:choose>
                    </c:forEach>
                </div>


                <div class="box-footer">
                    <c:if test="${requestScope.AgrochemicalInfo_Table ne null}">
                        <c:if test="${requestScope.Method ne null and requestScope.Action ne 'Done'}">&nbsp;
                            <button type="submit" class="btn btn-primary" title ="Guardar" name="Method" id="btnSubmit" value="Save" onclick="">
                                <i class="fa fa-save"></i> Guardar
                            </button>
                            <button type="Submit" class="btn btn-primary" title ="Cancelar" name="Method" id="btnSubmit"  onclick="location.href = 'agrochemicalManagement.do'">
                                <i class="fa fa-remove"></i> Cancelar
                            </button>                            
                        </c:if>

                        <c:if test="${requestScope.Method eq null or requestScope.Action eq 'Done'}"> &nbsp;
                            <button type="submit" class="btn btn-primary" title ="Agregar" name="Method" id="btnSubmit" value="Add">
                                <i class="fa fa-plus-square"></i> Agregar
                            </button>
                            <button type="submit" class="btn btn-primary" title ="Editar" name="Method" id="btnSubmit" value="Edit" onclick="return validateSelectedItem();">
                                <i class="fa fa-edit"></i> Editar
                            </button>
                            <button class="btn btn-primary" title ="Eliminar" name="Method" id="btnSubmit" value="Delete" onclick="return confirmDelete();">
                                <i class="fa fa-minus-square"></i> Eliminar
                            </button>
                        </c:if>
                    </c:if>
                </div>

            </div>

            <c:if test="${requestScope.AgrochemicalInfo_Table ne null}">
                <div class="box box-success">
                    <div class="box-body" id="info" > 
                        <div style="margin-top: 10px;"> 
                            <c:if test="${requestScope.Method eq null or requestScope.Action eq 'Done'}"> &nbsp;

                            </c:if>
                        </div>
                        <div class="table-responsive">

                            <table id="dtable" class="table table-bordered table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Nombre de Agroquimico</th>
                                        <th>Casa Comercial</th>
                                        <th>Ingrediente Activo</th>
                                        <th>Dosis Minima</th>
                                        <th>Dosis Maxima</th>
                                        <th>Unidad de Medida</th>
                                        <th>Tipo de Agroquimico</th>
                                        <th>Intervalo de Seguridad</th>
                                        <th>Periodo de Retardo</th>
                                        <th>Registado Por</th>
                                        <th>Fecha de Registro</th>
                                        <th>Fecha de Modificacion</th>
                                        <th>Cultivos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <c:forEach items="${AgrochemicalInfo_Table}" var="row" varStatus="status">
                                        <tr>
                                            <td>
                                                <c:if test="${requestScope.Method ne 'Edit' or (requestScope.ID == row.idAgrochemical and requestScope.ID ne 'new' ) }">
                                                    <input type="checkbox" class="minimal-red" name="ID" title="${row.idAgrochemical}" value="${row.idAgrochemical}"
                                                           ${requestScope.ID == row.idAgrochemical and requestScope.Method != 'Save' ? 'checked="checked"' : ''} onclick="radio(this);"/>
                                                </c:if>
                                            </td>
                                            <td>${row.AgrochemicalName}</td>
                                            <td>${row.Brand}</td>
                                            <td>${row.ActiveIngredient}</td>
                                            <td>${row.MinDose}</td>
                                            <td>${row.MaxDose}</td>
                                            <td>${row.UOM}</td>
                                            <td>${row.AgrochemicalType}</td>
                                            <td>${row.SecurityInterval}</td>
                                            <td>${row.DelayPeriod}</td>
                                            <td>${row.User}</td>
                                            <td>${row.InsertDate}</td>
                                            <td>${row.ModifiedDate}</td>
                                            <td>
                                                <button 
                                                    type="button" 
                                                    id="btnDel"
                                                    title="Agregar Materiales"
                                                    class="btn btn-primary" 
                                                    onclick="addCropType(${row.idAgrochemical});">
                                                    <i class="fa fa-plus"> Cultivo</i>
                                                </button>
                                            </td>
                                        </tr>
                                    </c:forEach>
                                </tbody>
                            </table> 
                        </div>
                    </div>
                </div>
            </c:if>

        </form>

        <script>
            $('#dtable').DataTable({
                "paging": false,
                "lengthChange": false,
                "searching": true,
                "ordering": true,
                "info": false,
                "autoWidth": false,
                "dom": 'T<"clear">lfrtip',
                "tableTools": {
                    "sSwfPath": "../plugins/datatables/extensions/TableTools/swf/copy_csv_xls_pdf.swf"
                },
                "columns": [
                    {"width": "2%"},
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null,
                    null
                ]
            });
            $('form').bootstrap3Validate(function (e, data) {
            });</script>


        <!-- iCheck 1.0.1 -->
        <script src="../plugins/iCheck/icheck.min.js"></script>

        <script>
            //iCheck for checkbox and radio inputs
            $('input[type="checkbox"].minimal, input[type="radio"].minimal').iCheck({
                checkboxClass: 'icheckbox_minimal-blue',
                radioClass: 'iradio_minimal-blue'
            });
            //Red color scheme for iCheck
            $('input[type="checkbox"].minimal-red, input[type="radio"].minimal-red').iCheck({
                checkboxClass: 'icheckbox_minimal-red',
                radioClass: 'iradio_minimal-red'
            });
            //Flat red color scheme for iCheck
            $('input[type="checkbox"].flat-red, input[type="radio"].flat-red').iCheck({
                checkboxClass: 'icheckbox_flat-green',
                radioClass: 'iradio_flat-green'
            });

        </script> 


        <div class="hide">
            <form name="frmAddCropType" id="frmAddCropType" method="post" action="addAgrochemicalCropType.do">
                <input type="hidden" id="selectedIdAgrochemical" name="idAgrochemical" value=""/>
                <input type="hidden" name="Action" value="AddCropType"/>
            </form>
        </div>  


        <c:if test="false">
            <c:forEach items='${requestScope}' var='p'>
                <ul>
                    <%-- Display the key of the current item, which
                         represents the parameter name --%>
                    <li>Parameter Name: <c:out value='${p.key}'/></li>

                    <%-- Display the value of the current item, which
                         represents the parameter value --%>
                    <li>Parameter Value: <c:out value='${p.value}'/></li>
                </ul>
            </c:forEach>
        </c:if>

    </section><!-- /.content -->
</div><!-- /.content-wrapper -->
