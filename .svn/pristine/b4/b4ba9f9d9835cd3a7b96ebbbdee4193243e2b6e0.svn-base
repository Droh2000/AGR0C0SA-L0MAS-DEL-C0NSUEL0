<%@ taglib uri="http://displaytag.sf.net" prefix="display"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
<!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
<![endif]-->
<link rel="stylesheet" href="../plugins/iCheck/all.css">

<script type="text/javascript">
    $(function () {
        $("#btnBack1").click(function () {
            $("#formBack").submit();
        });
        $("#btnBack2").click(function () {
            $("#formBack").submit();
        });
        $("#btnSubmit").click(function () {
            $("#selectedGuard").val($("#duallistbox_guard").val());
            $("#saveForm").submit();
        });
    });

</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            <i class='fa fa-user'></i> Asignación de Supervisor y Bombas
            <small></small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-caret-right"></i> Campos</a></li>
            <li class="active">Aqui</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">

        <c:choose>
            <c:when test="${requestScope.RESPONSE_CODE == 'PASS'}">                    
                <c:if test="${requestScope.RESPONSE_MESSAGE ne 'OK'}">


                    <div class="alert alert-success alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <h4>	<i class="icon fa fa-check"></i> OK</h4>
                        <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                        <c:out value="${requestScope.RESPONSE_DETAIL}" />
                    </div>
                </c:if>
            </c:when>
            <c:when test="${requestScope.RESPONSE_CODE == 'FAIL'}">
                <div class="alert alert-danger alert-dismissable">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h4><i class="icon fa fa-ban"></i> Error !</h4>
                    <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                    <c:out value="${requestScope.RESPONSE_DETAIL}" />
                </div>

            </c:when>
        </c:choose>

        <div class="row">

            <div class="col-md-6">
                <div class="box box-success">
                    <div class="box-header with-border">

                        <h3 class="box-title">Campo de Cultivo</h3>
                        <div class="box-tools pull-right">
                            <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="box-body">

                        <div class="box-body box-profile">
                            <h3 class="profile-username text-center">${requestScope.CampName}</h3>

                            <ul class="list-group list-group-unbordered">
                                <li class="list-group-item">
                                    <b>Num. Secciones</b> <a class="pull-right">${requestScope.SectionQty}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Latitude</b> <a class="pull-right">${requestScope.Latitude}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Longitud</b> <a class="pull-right">${requestScope.Longitude}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Clima</b> <a class="pull-right">${requestScope.Weather}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Precipitación</b> <a class="pull-right">${requestScope.Precipitation}</a>
                                </li>
                            </ul>

                            <h3 class="profile-username text-center">Supervisor Actual</h3>
                            <div class="box-body box-profile">
                                <img class="profile-user-img img-responsive center-block img-circle " src="showUserPictureById.do?idUser=${requestScope.idSupervisor}" alt="Supervisor">
                                <h3 class="profile-username text-center">${requestScope.SupervisorName}</h3>
                                <p class="text-muted text-center">${requestScope.SupervisorRole}</p>
                            </div><!-- /.box-body -->

                        </div><!-- /.box-body -->


                    </div>
                    <div class="box-footer text-center"></div>
                </div><!-- /.box --> 
            </div>
            <div class="col-md-6">  
                <form name="saveForm" id="saveForm"  method="POST" action="addCampSupervisor.do">
                    <div class="box box-success">
                        <div class="box-header with-border">

                            <h3 class="box-title">Seleccionar Supervisor</h3>
                            <div class="box-tools pull-right">
                                <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body box-profile">


                            <div class="table-responsive">

                                <table id="dtable" class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>                                            
                                            <th>Foto</th>
                                            <th>Supervisor</th>                                            
                                            <th>Asignación</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <c:forEach items="${Supervisor_Table}" var="row" varStatus="status">
                                            <tr>
                                                <td>
                                                    <div class="user-panel">
                                                        <div class="pull-left image">
                                                            <img src="showUserPictureById.do?idUser=${row.idSupervisor}" alt="supervisor image"/>
                                                        </div>
                                                    </div>                                                            
                                                </td>                                                
                                                <td style="vertical-align: middle;">${row.SupervisorName}</td>
                                                <td style="vertical-align: middle;">
                                                    <input type="radio" name = "idSupervisor" value="${row.idSupervisor}" ${row.SupervisorName == requestScope.SelectedSupervisor  ? 'checked' : ''} class="minimal-red" style="height:64px; width:64px; vertical-align: middle;">
                                                </td>

                                            </tr>
                                        </c:forEach>
                                    </tbody>
                                </table> 
                            </div>

                        </div><!-- /.box-body -->
                        <div class="box-footer text-center">
                            <div class="form-group">
                                <button type="button" id="btnBack1" class="btn btn-primary pull-left"><i class="fa fa-backward"></i> Regresar</button>
                                <button type="submit" id="btnSubmit" class="btn btn-primary pull-right"><i class="fa fa-save"></i> Guardar</button>
                                <input type="hidden" name="Action" id="Action"  value="SaveSelectedSupervisor"/>
                                <input type="hidden" name="idCamp" id="idCamp" value="${requestScope.idCamp}"/>
                            </div><!-- /.form-group -->
                        </div>
                    </div><!-- /.box -->       
                </form>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <form name="saveForm" id="saveForm"  method="POST" action="addCampSupervisor.do">
                    <div class="box box-success">
                        <div class="box-header with-border">

                            <h3 class="box-title">Seleccionar Bombas</h3>
                            <div class="box-tools pull-right">
                                <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div>
                        <div class="box-body">
                            <div class="form-group">
                                <label >Rebombeo Primario</label>
                                <select name="idBombPrimary" id="idBombPrimary" class="form-control"  data-title="Seleccione la bomba primaria" required>
                                    <option value="empty"></option>
                                    <c:forEach items="${Bomb_HashMap}" var="item">
                                        <option value="${item.key}"  ${requestScope.SelectedBombPrimary == item.key  ? 'selected' : ''}>${item.value}</option>
                                    </c:forEach>
                                </select>
                            </div>
                            <div class="form-group">
                                <label >Rebombeo Secundario</label>
                                <select name="idBombSecondary" id="idBombSecondary" class="form-control" data-title="Seleccione la bomba secundaria">
                                    <option value="empty"></option>
                                    <c:forEach items="${Bomb_HashMap}" var="item">
                                        <option value="${item.key}"  ${requestScope.SelectedBombSecondary == item.key  ? 'selected' : ''}>${item.value}</option>
                                    </c:forEach>
                                </select>
                            </div>

                        </div><!-- /.box-body -->
                        <div class="box-footer text-center">
                            <div class="form-group">
                                <button type="button" id="btnBack2" class="btn btn-primary pull-left"><i class="fa fa-backward"></i> Regresar</button>
                                <button type="submit" id="btnSubmit" class="btn btn-primary pull-right"><i class="fa fa-save"></i> Guardar</button>
                                <input type="hidden" name="Action" id="Action"  value="SaveSelectedBomb"/>
                                <input type="hidden" name="idCamp" id="idCamp" value="${requestScope.idCamp}"/>
                            </div><!-- /.form-group -->
                        </div>
                    </div><!-- /.box --> 
                </form>
            </div>
        </div>              


        <div class="hide">
            <form name="formBack" id="formBack" action="editCamp.do" method="post">
                <input type="hidden" name="idCamp" value="${requestScope.idCamp}"/>   
            </form>                        
        </div>


        <!-- iCheck 1.0.1 -->
        <script src="../plugins/iCheck/icheck.min.js"></script>

        <script>
    //iCheck for checkbox and radio inputs
    $('input[type="checkbox"].minimal, input[type="radio"].minimal').iCheck({
        checkboxClass: 'icheckbox_minimal-blue',
        radioClass: 'iradio_minimal-blue'
    });
    //Red color scheme for iCheck
    $('input[type="checkbox"].minimal-red, input[type="radio"].minimal-red').iCheck({
        checkboxClass: 'icheckbox_minimal-red',
        radioClass: 'iradio_minimal-red'
    });
    //Flat red color scheme for iCheck
    $('input[type="checkbox"].flat-red, input[type="radio"].flat-red').iCheck({
        checkboxClass: 'icheckbox_flat-green',
        radioClass: 'iradio_flat-green'
    });

        </script> 

        <c:if test="false">
            <c:forEach items='${requestScope}' var='p'>
                <ul>
                    <%-- Display the key of the current item, which
                         represents the parameter name --%>
                    <li>Parameter Name: <c:out value='${p.key}'/></li>

                    <%-- Display the value of the current item, which
                         represents the parameter value --%>
                    <li>Parameter Value: <c:out value='${p.value}'/></li>
                </ul>
            </c:forEach>
        </c:if>

    </section><!-- /.content -->
</div><!-- /.content-wrapper -->
