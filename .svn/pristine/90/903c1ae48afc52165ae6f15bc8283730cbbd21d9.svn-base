<%@ taglib uri="http://displaytag.sf.net" prefix="display"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>



<!-- daterange picker -->
<link href="../plugins/daterangepicker/daterangepicker-bs3.css" rel="stylesheet" type="text/css" />

<script type="text/javascript">
    $(function () {


        $('.confirmFormBtn').on("click", function () {
            var id = $(this).attr('id');
            var taskType = $("#f" + id).find('input[name="taskType"]').val();
            if (taskType === "Aplicacion Foliar") {
                $("#id4Update2").val(id);
                $('#questionModal').modal('show');
            } else if (taskType === "Riego") {
                $("#id4Update3").val(id);
                $('#inputModal').modal('show');
            }
            else {
                $("#id4Update").val(id);
                $('#confirmModal').modal('show');
            }
        });


        $(".reinforcement").click(function () {
            if ($(this).val() === "Si") {                
                $("#reinforcementDate").prop('required', true);
                $("#divDate").show();
            } else {
                $("#reinforcementDate").prop('required', false);
                $("#divDate").hide();
            }
        });


    });</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            <i class='fa fa-calendar-check-o'></i> Tareas para Cerrar
            <small>Por favor seleccione las tareas que seran terminadas</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-caret-right"></i> Tarea</a></li>
            <li class="active">Aqui</li>
        </ol>
    </section>


    <!-- Main content -->
    <section class="content">

        <c:choose>
            <c:when test="${requestScope.RESPONSE_CODE == 'PASS'}">                    
                <c:if test="${requestScope.RESPONSE_MESSAGE ne 'OK'}">


                    <div class="alert alert-success alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <h4>	<i class="icon fa fa-check"></i> OK</h4>
                        <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                        <c:out value="${requestScope.RESPONSE_DETAIL}" />
                    </div>
                </c:if>
            </c:when>
            <c:when test="${requestScope.RESPONSE_CODE == 'FAIL'}">
                <div class="alert alert-danger alert-dismissable">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h4><i class="icon fa fa-ban"></i> Error !</h4>
                    <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                    <c:out value="${requestScope.RESPONSE_DETAIL}" />
                </div>

            </c:when>
        </c:choose>



        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title">Cerrar Tareas</h3>
                <div class="box-tools pull-right">
                    <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div><!-- /.box-header -->
            <div class="box-body">
                <div class="table-responsive">
                    <table id="dtable" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>    
                                <th>Numero</th>
                                <th>Tarea</th>
                                <th>Campo</th>
                                <th>Seccion</th>
                                <th>Fecha Tarea</th>
                                <th>Supervisor</th>
                                <th>Comentarios</th>
                                <th>Estatus</th>
                                <th>Fecha Inserción</th>                                
                                <th>Registrada por</th>                              
                                <th>Cerrar</th>
                            </tr>
                        </thead>
                        <tbody>

                            <c:forEach items="${TaskReport_Table}" var="row" varStatus="status">
                                <tr>                                 
                                    <td>${row.idTask}</td>
                                    <td>${row.TaskType}</td>
                                    <td>${row.CampName}</td>
                                    <td>${row.SectionName}</td>
                                    <td>${row.TaskDate}</td>
                                    <td>${row.SupervisorName}</td>
                                    <td>${row.Comments}</td>
                                    <td>${row.Status}</td>
                                    <td>${row.InsertDate}</td>
                                    <td>${row.User}</td>
                                    <td>
                                        <form name="f${row.idTask}" id="f${row.idTask}" action="" method="post">
                                            <input type="hidden" name="idTask" id="idTask" value="${row.idTask}"/>
                                            <input type="hidden" name="taskType" id="taskType" value="${row.TaskType}"/>
                                            <button type="button" name="${row.idTask}" id="${row.idTask}" class="btn btn-primary xxs confirmFormBtn" title ="Cerrar" onclick="">
                                                <i class="fa fa-times"></i>
                                            </button>                                                
                                        </form>                                         
                                    </td>                                        
                                </tr>
                            </c:forEach>
                        </tbody>
                    </table> 
                </div>

            </div><!-- /.box-body -->
        </div>





        <div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form name="formConfirm" action="closeTask.do" method="post">
                        <div class="modal-header alert-warning">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="myModalLabel"><i class="icon fa fa-times"></i> Cerrar Tarea</h4>
                        </div>
                        <div class="modal-body">
                            <p><h3>Esta usted seguro de cerrar esta tarea?</h3></p>
                            <input type="hidden" name="idTask" id="id4Update" value=""/>
                            <input type="hidden" name="status" id="status" value="Terminada"/>
                            <input type="hidden" name="Action" id="Action" value="CloseTask"/>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary pull-left" data-dismiss="modal">No</button>
                            <button type="submit" id="btnConfirmYes" class="btn btn-primary pull-right">Si</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


        <div class="modal fade" id="questionModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form name="formConfirm" action="closeTask.do" method="post">
                        <div class="modal-header alert-danger">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="myModalLabel"><i class="icon fa fa-times"></i> Cerrar Tarea</h4>
                        </div>
                        <div class="modal-body">
                            <p><h3>Requiere Refuerzo?</h3></p>
                            <input type="hidden" name="idTask" id="id4Update2" value=""/>
                            <input type="hidden" name="status" id="status" value="Terminada"/>
                            <input type="hidden" name="Action" id="Action" value="CloseTask"/>

                            <div class="form-group">
                                <input type="radio" name = "reinforcement" value="Si" class="minimal-red reinforcement" style="height:20px; width:20px; vertical-align: middle;" checked> Si requiere refuerzo.&nbsp;&nbsp;&nbsp;
                                <input type="radio" name = "reinforcement" value="No" class="minimal-red reinforcement" style="height:20px; width:20px; vertical-align: middle;"> No requiere no es necesario.
                            </div>
                            <div id="divDate" class="form-group">
                                <label>
                                    Fecha de Refuerzo
                                </label>
                                <div class="taskDate input-group">                                    
                                    <div class="input-group-addon">
                                        <i class="fa fa-calendar"></i>
                                    </div>
                                    <input name="reinforcementDate" type="text" class="form-control input-sm mydate" required id="reinforcementDate" value="" size="15" />
                                </div>
                            </div>
                        </div>
                        <br>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary pull-left" data-dismiss="modal">Cerrar</button>
                            <button type="submit" id="btnConfirmYes" class="btn btn-primary pull-right">Guardar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>




        <div class="modal fade" id="inputModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" data-keyboard="false">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <form name="formConfirm" action="closeTask.do" method="post">
                        <div class="modal-header alert-warning">
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                            <h4 class="modal-title" id="myModalLabel"><i class="icon fa fa-times"></i> Cerrar Tarea</h4>
                        </div>
                        <div class="modal-body">
                            <p><h3>Por favor antes de cerrar la tarea hay que completar la siguiente información:</h3></p>
                            <input type="hidden" name="idTask" id="id4Update3" value=""/>
                            <input type="hidden" name="status" id="status" value="Terminada"/>
                            <input type="hidden" name="Action" id="Action" value="CloseTask"/>

                            <div class="form-group">
                                <label>Uso real de Fertilizante: </label>
                                <input name="realUseFertilizer" type="text" class="form-control pull-right" id="realUseFertilizer" required value="${requestScope.SelectedRealUseFertilizer}" />
                            </div>

                        </div>
                        <br>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-primary pull-left" data-dismiss="modal">Cancelar</button>
                            <button type="submit" id="btnConfirmYes" class="btn btn-primary pull-right">Cerrar Tarea</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>


        <!-- date-range-picker -->
        <script src="../plugins/daterangepicker/moment.min.js" type="text/javascript"></script>
        <script src="../plugins/daterangepicker/daterangepicker.js" type="text/javascript"></script>

        <script type="text/javascript">

    $('.mydate').daterangepicker({
        singleDatePicker: true,
        format: 'DD/MM/YYYY',
        drops: 'up',
        locale: {
            daysOfWeek: [
                "Do",
                "Lu",
                "Ma",
                "Mi",
                "Ju",
                "Vi",
                "Sa"
            ],
            monthNames: [
                "Enero",
                "Febrero",
                "Marzo",
                "Abril",
                "Mayo",
                "Junio",
                "Julio",
                "Agosto",
                "Septiembre",
                "Octubre",
                "Noviembre",
                "Diciembre"
            ]
        }
    });
        </script> 

        <c:if test="false">
            <c:forEach items='${requestScope}' var='p'>
                <ul>
                    <%-- Display the key of the current item, which
                         represents the parameter name --%>
                    <li>Parameter Name: <c:out value='${p.key}'/></li>

                    <%-- Display the value of the current item, which
                         represents the parameter value --%>
                    <li>Parameter Value: <c:out value='${p.value}'/></li>
                </ul>
            </c:forEach>
        </c:if>

    </section><!-- /.content -->
</div><!-- /.content-wrapper -->
