<%@ taglib uri="http://displaytag.sf.net" prefix="display"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            Bienvenido a nuestro sitio
            <small>${sessionScope.firstName}&nbsp;${sessionScope.lastName}</small>
        </h1>
    </section>

    <br>
    <section class="content">
        <c:if test="${requestScope.TaskComments_Table ne null}">
            <div class="row">
                <div class="col-md-6">
                    <div class="box box-success">
                        <div class="box-header with-border">
                            <h3 class="box-title"><i class="icon fa fa-file-o"></i> Comentarios de Tareas en Proceso</h3>
                            <div class="box-tools pull-right">
                                <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                            </div>
                        </div><!-- /.box-header -->
                        <div class="box-body">
                            <div class="table-responsive">
                                <table id="dtable" class="table table-bordered table-striped table-hover">
                                    <thead>
                                        <tr>    
                                            <th>Num de Tarea</th>
                                            <th>Tipo de Tarea</th>
                                            <th>Campo</th>
                                            <th>Fecha de Tarea</th>
                                            <th>Supervisor</th>
                                            <th>Comentarios</th>
                                            <th>Fecha de Comentarios</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <c:forEach items="${TaskComments_Table}" var="row" varStatus="status">
                                            <tr>
                                                <td>${row.idTask}</td>
                                                <td>${row.TaskType}</td>
                                                <td>${row.CampName}</td>
                                                <td>${row.TaskDate}</td>
                                                <td>${row.Supervisor}</td>
                                                <td>${row.Comments}</td>
                                                <td>${row.CommentsDate} </td>
                                            </tr>
                                        </c:forEach>
                                    </tbody>
                                </table> 
                            </div>

                        </div><!-- /.box-body -->        
                    </div>
                </div>
            </div>
        </c:if>
    </section>
    
</div>




