package AgrocosaTransactions;

import SIDWebEngine.*;
import java.sql.*;
import xmlNodeArray.*;

public class SaveNewShippingOrderTransaction extends SIDWebTransaction {

    protected PreparedStatement pstmtInsertOrder;
    protected PreparedStatement pstmtInsertDetail;
    protected PreparedStatement pstmtInsertHistory;
    protected PreparedStatement pstmtPalletProduct;
    protected PreparedStatement pstmtUser;

    /**
     * Default Constructor
     *
     * @exception (none)
     */
    public SaveNewShippingOrderTransaction() {
        super();
        SetTransactionType(SIDWebTransaction.SaveType);
    }

    /**
     * Checks to see if the node Array is supported
     *
     * @param nodeArray
     * @return <B>true</B> if the nodeArray is supported. <B>false</B> otherwise
     * @exception (none)
     */
    @Override
    public boolean Supports(xmlNodeArray nodeArray) {

        //Add tag names as comma separated Strings to the mandatoryTags array
        String[] mandatoryTags = {
            "idUser",
            "dataTable4Save",
            "pickupNumber"
        };

        //Add tag names as comma separated Strings to the optionalTags array
        String[] optionalTags = {};
        //Add tag names as comma separated Strings to the mandatorySets array
        String[] mandatorySets = {};
        //Add tag names as comma separated Strings to the optionalSetTags array
        String[] optionalSets = {};

        xmlNodeArray errArray = new xmlNodeArray();
        for (int i = 0; i < mandatoryTags.length; i++) {
            if (!nodeArray.existValue(mandatoryTags[i])) {
                System.out.println("<SaveNewShippingOrderTransaction::Supports> " + mandatoryTags[i] + " Mandatory tag not found or value is empty/null");
                errArray.add("ERROR", "MANDATORY_TAG_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < optionalTags.length; i++) {
            if (nodeArray.exist(optionalTags[i]) && !nodeArray.existValue(optionalTags[i])) {
                System.out.println("<SaveNewShippingOrderTransaction::Supports> " + optionalTags[i] + " Optional tag not found or value is empty/null");
                errArray.add("OPTIONAL_TAG_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < mandatorySets.length; i++) {
            if (nodeArray.find(mandatorySets[i]) == null || nodeArray.find(mandatorySets[i]).getTable() == null || nodeArray.find(mandatorySets[i]).getTable().getRowsQty() == 0) {
                System.out.println("<SaveNewShippingOrderTransaction::Supports> " + mandatorySets[i] + " Mandatory Set not found or value is empty/null");
                errArray.add("MANDATORY_SET_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        for (int i = 0; i < optionalSets.length; i++) {
            if (nodeArray.find(mandatorySets[i]) != null && (nodeArray.find(mandatorySets[i]).getTable() == null || nodeArray.find(mandatorySets[i]).getTable().getRowsQty() == 0)) {
                System.out.println("<SaveNewShippingOrderTransaction::Supports> " + optionalSets[i] + " Optional Set not found or value is empty/null");
                errArray.add("OPTIONAL_SET_NOT_FOUND_ERROR");
                errArray.add("ERROR_MSG", mandatoryTags[i]);
                this.SetError(errArray);
                return false;
            }
        }
        return true;
    }

    /**
     * Prepares the SQL statements to be executed
     *
     * @return <B>true</B> for successful preparation; <B>false</B> for
     * unsuccessful preparation
     * @exception (none)
     */
    @Override
    public synchronized boolean PrepareStatements() {
        //Note1 : Use PreparedStatements instead of Statements where ever possible
        //Note2 : If transaction contains no prepared statements, delete entire function
        //        Unless there are nested transaction, then Prepare will call those.
        try {
            Connection con = this.GetSIDDataBase().GetConnection();

            pstmtInsertOrder = con.prepareStatement("Insert into shippingorder ( "
                    + "idCustomer, "
                    + "PickupNumber, "
                    + "ShippingDate, "
                    + "Status, "
                    + "Comments, "
                    + "InsertDate, "
                    + "ModifiedDate, "
                    + "idUser "
                    + ") Values( "
                    + "(select idCustomer from customer where customername = ? and active = 1), "//1 idCustomer
                    + "?, "//2 PickupNumber
                    + "Now(), "// ShippingDate
                    + "'Nueva', "// Status
                    + "?, "//3 Comments
                    + "Now(), "//Insert Date
                    + "Now(), "//Modified Date
                    + "? " //4 idUser
                    + ")", Statement.RETURN_GENERATED_KEYS);

            pstmtInsertDetail = con.prepareStatement("Insert into shippingorderdetail ( "
                    + "idShippingOrder, "
                    + "ProductName, "
                    + "Size, "
                    + "Color, "
                    + "Quantity "
                    + ") Values( "
                    + "?, "// 1 idShippingOrder
                    + "?, "// 2 ProductName
                    + "?, "// 3 Size
                    + "?, "// 4 Color
                    + "? " // 5 Quantity
                    + ")");

            pstmtInsertHistory = con.prepareStatement("Insert into shippingorderhistory ( "
                    + "idShippingOrder, "
                    + "CustomerName, "
                    + "PickupNumber, "
                    + "Process, "
                    + "MovementType, "
                    + "Quantity,  "
                    + "Comments, "
                    + "User, "
                    + "InsertDate "
                    + ") Values( "
                    + "?, "// 1 idShippingOrder
                    + "?, "// 2 CustomerName
                    + "?, "// 3 PickupNumber
                    + "'Embarque', "// Process
                    + "'Nueva', "// MovementType
                    + "?, "// 4 Quantity
                    + "?, "// 5 Comments
                    + "?, "// 6 User
                    + "Now() " // InsertDate
                    + ")");

            pstmtPalletProduct = con.prepareStatement("SELECT * "
                    + "FROM palletproduct "
                    + "Where ProductName = ? ");

            pstmtUser = con.prepareStatement("select concat(FirstName,' ',LastName) User "
                    + "from user "
                    + "where idUser = ? ");

            this.addPreparedStatement(pstmtInsertOrder);
            this.addPreparedStatement(pstmtInsertDetail);
            this.addPreparedStatement(pstmtInsertHistory);
            this.addPreparedStatement(pstmtPalletProduct);
            this.addPreparedStatement(pstmtUser);

            return true;
        } catch (SQLException e) {
            System.out.println("SaveNewShippingOrderTransaction::PrepareStatements> SQLException: " + e.getMessage());
            return false;
        }
    }

    /**
     * executes sql statements using input arguments and returns result
     *
     * @return valid node array if successful else null
     * @exception SQLException if sql error occurs
     * @exception Exception if non sql error occurs
     */
    @Override
    public synchronized xmlNodeArray Execute() throws SQLException, Exception {
        Connection conn = null;
        xmlNodeArray resultArray = null;
        ResultSet rset = null;
        int rowsAffected = 0;
        String customer = null;
        String productName = null;
        int quantity = 0;
        int idUser = 0;
        String dataTable4Save = "";
        String comments = "";
        int idShippingOrder = 0;
        boolean boolFailSaveDetail = false;
        String pickupNumber = "";
        String size = "";
        String color = "";
        int totalQty = 0;
        String userName = "";

        try {
            conn = this.GetSIDDataBase().GetConnection();
            conn.setAutoCommit(false);
            resultArray = new xmlNodeArray();

            idUser = GetNodeArray().find("idUser").getIntValue();
            dataTable4Save = GetNodeArray().find("dataTable4Save").getStringValue();
            if (this.GetNodeArray().existValue("customer")) {
                customer = GetNodeArray().find("customer").getStringValue();
            }
            if (this.GetNodeArray().existValue("comments")) {
                comments = GetNodeArray().find("comments").getStringValue();
            }
            if (this.GetNodeArray().existValue("pickupNumber")) {
                pickupNumber = GetNodeArray().find("pickupNumber").getStringValue();
            }

            //User Name
            pstmtUser.setInt(1, idUser);
            rset = pstmtUser.executeQuery();
            if (rset.next()) {
                userName = rset.getString("User");
            }
            if (rset != null) {
                rset.close();
                rset = null;
            }

            //replace
            dataTable4Save = dataTable4Save.replace("[[", "");
            dataTable4Save = dataTable4Save.replace("]]", "");
            dataTable4Save = dataTable4Save.replace("\"", "");
            dataTable4Save = dataTable4Save.replace("],[", "|");

            String[] rowsData = dataTable4Save.split("\\|");

            //Insert Order
            pstmtInsertOrder.setString(1, customer);
            pstmtInsertOrder.setString(2, pickupNumber);
            pstmtInsertOrder.setString(3, comments);
            pstmtInsertOrder.setInt(4, idUser);
            rowsAffected = pstmtInsertOrder.executeUpdate();
            if (rowsAffected > 0) {
                //get id
                rset = pstmtInsertOrder.getGeneratedKeys();
                if (rset.next()) {
                    idShippingOrder = rset.getInt(1);
                }
                if (rset != null) {
                    rset.close();
                    rset = null;
                }

                //Insert detail
                for (String rowsData1 : rowsData) {
                    String[] fieldData = rowsData1.split(",");
                    productName = fieldData[1]; //material
                    quantity = Integer.parseInt(fieldData[2]); //qty
                    totalQty += quantity;

                    pstmtPalletProduct.setString(1, productName);
                    rset = pstmtPalletProduct.executeQuery();
                    if (rset.next()) {
                        size = rset.getString("Size");
                        color = rset.getString("Color");
                    }
                    if (rset != null) {
                        rset.close();
                        rset = null;
                    }

                    //Insert detail
                    pstmtInsertDetail.setInt(1, idShippingOrder);
                    pstmtInsertDetail.setString(2, productName);
                    pstmtInsertDetail.setString(3, size);
                    pstmtInsertDetail.setString(4, color);
                    pstmtInsertDetail.setInt(5, quantity);
                    rowsAffected = pstmtInsertDetail.executeUpdate();
                    if (rowsAffected == 0) {
                        boolFailSaveDetail = true;
                    }
                }
            } else {
                conn.rollback();
                resultArray.add("error", "La orden de embarque no pudo ser registrada.");
                resultArray.add("RESPONSE_CODE", "FAIL");
                resultArray.add("RESPONSE_MESSAGE", "La orden de embarque no pudo ser registrada.");
                resultArray.add("RESPONSE_DETAIL", "");
            }

            if (!boolFailSaveDetail) {

                //Insert order history
                pstmtInsertHistory.setInt(1, idShippingOrder);
                pstmtInsertHistory.setString(2, customer);
                pstmtInsertHistory.setString(3, pickupNumber);
                pstmtInsertHistory.setInt(4, totalQty);
                pstmtInsertHistory.setString(5, comments);
                pstmtInsertHistory.setString(6, userName);
                rowsAffected = pstmtInsertHistory.executeUpdate();
                if (rowsAffected > 0) {
                    conn.commit();
                    resultArray.add("pass", "La orden de embarque numero = " + idShippingOrder + " ha sido registrada exitosamente.");
                    resultArray.add("RESPONSE_CODE", "PASS");
                    resultArray.add("RESPONSE_MESSAGE", "La orden de embarque numero = " + idShippingOrder + " ha sido registrada exitosamente.");
                    resultArray.add("RESPONSE_DETAIL", "");
                } else {
                    conn.rollback();
                    resultArray.add("error", "El historial de la orden de embarque no pudo ser registrada.");
                    resultArray.add("RESPONSE_CODE", "FAIL");
                    resultArray.add("RESPONSE_MESSAGE", "El historial de la orden de embarque no pudo ser registrada.");
                    resultArray.add("RESPONSE_DETAIL", "");
                }
            } else {
                conn.rollback();
                resultArray.add("error", "El detalle de la orden de embarque no pudo ser registrada.");
                resultArray.add("RESPONSE_CODE", "FAIL");
                resultArray.add("RESPONSE_MESSAGE", "El detalle de la orden de embarque no pudo ser registrada.");
                resultArray.add("RESPONSE_DETAIL", "");
            }

            return resultArray;

        } catch (SQLException e) {
            conn.rollback();
            System.out.println("SaveNewShippingOrderTransaction::Execute> SQLException: " + e.getMessage());
            resultArray = new xmlNodeArray();
            resultArray.add("RESPONSE_CODE", "FAIL");
            resultArray.add("RESPONSE_MESSAGE", "SQLException:" + e.getMessage());
            resultArray.add("RESPONSE_DETAIL", e.getMessage());
            return resultArray;
        } catch (Exception ex) {
            conn.rollback();
            System.out.println("SaveNewShippingOrderTransaction::Execute> Exception: " + ex.getMessage());
            resultArray = new xmlNodeArray();
            resultArray.add("RESPONSE_CODE", "FAIL");
            resultArray.add("RESPONSE_MESSAGE", "Exception:" + ex.getMessage());
            resultArray.add("RESPONSE_DETAIL", ex.getMessage());
            return resultArray;
        } finally {
            if (rset != null) {
                rset.close();
                rset = null;
            }
            CloseStatements();
        }
    }

    /**
     * Generates an xmlNodeArray containing parameters for this transaction
     *
     * @return xmlNodeArray that contains parameters for the transaction
     * @exception (none)
     */
    @Override
    public xmlNodeArray GenerateTestParameters() {
        xmlNodeArray nodeArr = new xmlNodeArray();
        nodeArr.add("TRANSACTION_CLASS_TO_EXECUTE", "JonesPlasticTransactions.SaveNewShippingOrderTransaction");
        nodeArr.add("idUser", "1");
        nodeArr.add("customer", "BRP");
        nodeArr.add("comments", "Embarcar antes del medio dia");
        nodeArr.add("dataTable4Save", "[[\"BRP\",\"707900700\",\"1\",\"x\"],[\"BRP\",\"707900702\",\"2\",\"x\"],[\"BRP\",\"707900704\",\"3\",\"x\"],[\"BRP\",\"707900705\",\"4\",\"x\"]]");

        return nodeArr;

    }

    /**
     * The main method for the transaction. Creates a database connection and an
     * error Array, then executes the transaction and reports any errors
     *
     * @param argv argv[0] is an optional configuration file name
     * @exception (none)
     */
    public static void main(String[] argv) {
        try {
            SaveNewShippingOrderTransaction transaction = new SaveNewShippingOrderTransaction();
            SIDWebTransaction resultTransaction = null;
            xmlNodeArray inputParameterArray = null;
            //CIMDataBase database = null;
            System.out.println("Usage: java -classpath ...JonesPlasticTransactions.SaveNewShippingOrderTransaction");

            //<Add Database connection parameter for testing>
            database = new SIDDataBase("jdbc:mysql://localhost:3306/jonesplastic", "root", "entrar123");

            transaction.SetSIDDataBase(database);
            inputParameterArray = transaction.GenerateTestParameters();
            if (!transaction.IsValidTransaction()) {
                System.out.println(" SaveNewShippingOrderTransaction contains an invalid transaction type.");
            } else {
                if (!transaction.Supports(inputParameterArray)) {
                    System.out.println(" SaveNewShippingOrderTransaction does not support this list of parameters.");
                } else {
                    resultTransaction = database.ExecuteTransaction("JonesPlasticTransactions.SaveNewShippingOrderTransaction", inputParameterArray);
                    if (resultTransaction == null) {
                        System.out.println("The transaction's result array is null.");
                    } else {
                        if (resultTransaction.GetError() != null) {
                            resultTransaction.GetError().print();
                        } else {
                            if (resultTransaction.GetResultArray() == null) {
                                System.out.println("SaveNewShippingOrderTransaction - No results were returned.");
                            } else {
                                xmlNodeArray array = resultTransaction.GetResultArray();
                                String str = xmlNodeArray.xmlNodeArray2String(array);
                                array = xmlNodeArray.string2xmlNodeArray(str);
                                System.out.println(str);
                            }
                        }
                    }
                }
            }
        } catch (Exception e) {
            System.out.println("SaveNewShippingOrderTransaction::main> caught exception " + e.getMessage());
            e.printStackTrace();
        }
    }
}
