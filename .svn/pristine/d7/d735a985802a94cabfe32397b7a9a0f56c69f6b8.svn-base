                                    Tipos de Labor</a></li>
                            <li><a href="engineManagement.do">
                                    <i class='${sessionScope.Controller == 'engineManagement.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    Motores</a></li>
                            <li><a href="waterPumpManagement.do">
