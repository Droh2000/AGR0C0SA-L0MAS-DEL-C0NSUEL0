                                    <span>Labranza</span></a></li>
                            <li><a href="commentsApplicationInfo.do">
                                    <i class='${sessionScope.Controller == 'commentsApplicationInfo.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    <span>Aplicación Foliar</span></a></li>
                            <li><a href="commentsPickingInfo.do">
                                    <i class='${sessionScope.Controller == 'commentsPickingInfo.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    <span>Cosecha</span></a></li>
                            <li><a href="commentsJournalInfo.do">
                                    <i class='${sessionScope.Controller == 'commentsJournalInfo.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    <span>Jornal</span></a></li>
                            <li><a href="commentsIrrigationInfo.do">
                                    <i class='${sessionScope.Controller == 'commentsIrrigationInfo.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    <span>Riego</span></a></li>
                        </ul>
                    </li>

                    <li class="treeview ${sessionScope.acordion == 'Salir'  ? 'active' : ''}">
                        <a href="${requestScope['javax.servlet.forward.context_path']}/public/logout"><i class='fa fa-sign-out'></i> <span>Salir</span> <i class="fa fa-angle-left pull-right"></i></a>
                    </li>    
                </c:when>    

                <c:when test="${sessionScope.rol eq 'Broker'}">
                    <li class="treeview ${sessionScope.acordion == 'Crossdock'  ? 'active' : ''}">
                        <a href="#"><i class='fa fa-building-o'></i> <span>Bodega</span> <i class="fa fa-angle-left pull-right"></i></a>
                        <ul class="treeview-menu">
                            <li><a href="newShippingOrder.do">
                                    <i class='${sessionScope.Controller == 'newShippingOrder.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    Orden de Embarque</a></li>
                        </ul>
                    </li>
                    <li class="treeview ${sessionScope.acordion == 'Report'  ? 'active' : ''}">
                        <a href="#"><i class='fa fa-file-text-o'></i> <span>Reportes</span> <i class="fa fa-angle-left pull-right"></i></a>
                        <ul class="treeview-menu">                                 
                            <li><a href="shippingOrderReport.do">
                                    <i class='${sessionScope.Controller == 'shippingOrderReport.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    Reporte de Embarques</a></li>                                    
                        </ul>
                    </li>  
                    <li class="treeview ${sessionScope.acordion == 'Salir'  ? 'active' : ''}">
                        <a href="${requestScope['javax.servlet.forward.context_path']}/public/logout"><i class='fa fa-sign-out'></i> <span>Salir</span> <i class="fa fa-angle-left pull-right"></i></a>
                    </li>  
                </c:when>    

                <c:otherwise>
                    <li class="treeview ${sessionScope.acordion == 'Salir'  ? 'active' : ''}">
                        <a href="${requestScope['javax.servlet.forward.context_path']}/public/logout"><i class='fa fa-sign-out'></i> <span>Salir</span> <i class="fa fa-angle-left pull-right"></i></a>
                    </li>                                        
                </c:otherwise>
            </c:choose>
        </ul><!-- /.sidebar-menu -->
    </section>
    <!-- /.sidebar -->
</aside>
