                                    Bombas</a></li>
                            <li><a href="bombManagement.do">
                                    <i class='${sessionScope.Controller == 'bombManagement.do' ? 'fa fa-dot-circle-o text-red' : 'fa fa-circle-o'}'></i>
                                    Cuarto de Rebombeo</a></li>
                            <li><a href="landTypeManagement.do">
