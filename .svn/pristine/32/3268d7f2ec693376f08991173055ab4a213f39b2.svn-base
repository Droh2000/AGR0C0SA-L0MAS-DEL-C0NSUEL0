<%@ taglib uri="http://displaytag.sf.net" prefix="display"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c"%>
<%@ taglib uri="http://java.sun.com/jsp/jstl/fmt" prefix="fmt" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/functions" prefix="fn" %>


<!-- HTML5 Shim and Respond.js IE8 support of HTML5 elements and media queries -->
<!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
<!--[if lt IE 9]>
    <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
    <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
<![endif]-->
<script type="text/javascript">

    $(function () {

        $('.confirmFormBtn').on("click", function () {
            var id = $(this).attr('id');
            $("#id4Delete").val(id);
            $('#confirmModal').modal('show');
        });
    });

    function addCrop(idCampSection)
    {

        $('#selectedIdCampSection').val(idCampSection);
        $('#frmAddCrop').submit();

    }


</script>

<!-- Content Wrapper. Contains page content -->
<div class="content-wrapper">
    <!-- Content Header (Page header) -->
    <section class="content-header">
        <h1>
            <i class='fa fa-map-o'></i> Configuración de Campos de Cultivos
            <small>&nbsp;</small>
        </h1>
        <ol class="breadcrumb">
            <li><a href="#"><i class="fa fa-caret-right"></i> Campos</a></li>
            <li class="active">Aqui</li>
        </ol>
    </section>

    <!-- Main content -->
    <section class="content">

        <c:choose>
            <c:when test="${requestScope.RESPONSE_CODE == 'PASS'}">                    
                <c:if test="${requestScope.RESPONSE_MESSAGE ne 'OK'}">


                    <div class="alert alert-success alert-dismissable">
                        <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                        <h4>	<i class="icon fa fa-check"></i> OK</h4>
                        <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                        <c:out value="${requestScope.RESPONSE_DETAIL}" />
                    </div>
                </c:if>
            </c:when>
            <c:when test="${requestScope.RESPONSE_CODE == 'FAIL'}">
                <div class="alert alert-danger alert-dismissable">
                    <button type="button" class="close" data-dismiss="alert" aria-hidden="true">×</button>
                    <h4><i class="icon fa fa-ban"></i> Error !</h4>
                    <c:out value="${requestScope.RESPONSE_MESSAGE}" /><br />
                    <c:out value="${requestScope.RESPONSE_DETAIL}" />
                </div>

            </c:when>
        </c:choose>

        <div class="row">
            <div class="col-md-6">
                <div class="box box-success">
                    <div class="box-header with-border">

                        <h3 class="box-title">Campo de Cultivo</h3>
                        <div class="box-tools pull-right">
                            <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="box-body">

                        <div class="box-body box-profile">
                            <h3 class="profile-username text-center">${requestScope.CampName}</h3>

                            <ul class="list-group list-group-unbordered">
                                <li class="list-group-item">
                                    <b>Num. Secciones</b> <a class="pull-right">${requestScope.SectionQty}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Latitude</b> <a class="pull-right">${requestScope.Latitude}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Longitud</b> <a class="pull-right">${requestScope.Longitude}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Clima</b> <a class="pull-right">${requestScope.Weather}</a>
                                </li>
                                <li class="list-group-item">
                                    <b>Precipitación</b> <a class="pull-right">${requestScope.Precipitation}</a>
                                </li>
                            </ul>
                        </div><!-- /.box-body -->
                    </div>
                    <div class="box-footer text-center"></div>
                </div><!-- /.box --> 
            </div>


            <div class="col-md-6">
                <div class="box box-success">
                    <div class="box-header with-border">

                        <h3 class="box-title">Supervisor y Bombas</h3>
                        <div class="box-tools pull-right">
                            <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                        </div>
                    </div>
                    <div class="box-body box-profile">
                        <img class="profile-user-img img-responsive center-block img-circle " src="showUserPictureById.do?idUser=${requestScope.idSupervisor}" alt="Supervisor">
                        <h3 class="profile-username text-center">${requestScope.SupervisorName}</h3>
                        <p class="text-muted text-center">${requestScope.SupervisorRole}</p>

                        <ul class="list-group list-group-unbordered">
                            <li class="list-group-item">
                                <b>Rebombeo Primario: </b> <a class="pull-right">${requestScope.BombPrimary}</a>
                            </li>
                            <li class="list-group-item">
                                <b>Rebombeo Secundario: </b> <a class="pull-right">${requestScope.BomSecondary}</a>
                            </li>
                        </ul>
                    </div><!-- /.box-body -->
                    <div class="box-footer text-center">
                        <form name="supervisorform" action="addCampSupervisor.do" method="post">
                            <input type="hidden" name="idCamp" id="idCamp" value="${requestScope.idCamp}"/>
                            <button type="submit" class="btn btn-primary"><i class="fa fa-edit"></i> Actualizar</button>
                        </form>
                    </div>
                </div><!-- /.box --> 
            </div>                                       
        </div>




        <div class="box box-success">
            <div class="box-header with-border">

                <h3 class="box-title">Secciones</h3>
                <div class="box-tools pull-right">
                    <button class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>
            <div class="box-body box-profile">
                <div class="table-responsive">
                    <table id="dtable" class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>                        
                                <th>Nombre Sección</th>
                                <th>Area</th>                                            
                                <th>Cantidad de Surcos</th>                                            
                                <th>Tipo de Tierra</th>
                                <th>Tipo de Cinta</th>
                                <th>Cultivo</th>
                                <th>Variedad</th>
                                <th>Editar</th>
                                <th>Borrar</th>
                            </tr>
                        </thead>
                        <tbody>
                            <c:forEach items="${Section_Table}" var="row" varStatus="status">
                                <tr>
                                    <td>${row.SectionName}</td>
                                    <td>${row.Area}</td>
                                    <td>${row.GrooveQty}</td>
                                    <td>${row.LandTypeName}</td>
                                    <td>${row.PipeTypeName}</td>
                                    <td>${row.SectionCropType}</td>
                                    <td>${row.SectionCrop}</td>
                                    <td>
                                        <button 
                                            type="button" 
                                            id="btnAdd"
                                            title="Cultivos"
                                            class="btn btn-primary xxs" 
                                            onclick="addCrop(${row.idCampSection});">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </td>
                                    <td>
                                        <form name="f${row.idCampSection}" id="${row.idCampSection}" action="" method="post">
                                            <input type="hidden" name="idCampSection" id="idCampSection" value="${row.idCampSection}"/>
                                            <input type="hidden" name="Action" id="Action" value="DeleteSectionCamp"/>

                                            <button type="button" name="${row.idCampSection}" id="${row.idCampSection}" class="btn btn-primary xxs confirmFormBtn" title ="Borrar" onclick="">
                                                <i class="fa fa-trash"></i>
                                            </button>                                                
                                        </form> 

                                    </td>
                                </tr>
                            </c:forEach>
                        </tbody>
                    </table> 
                </div>
            </div><!-- /.box-body -->
            <div class="box-footer text-center">
                <button type="button" class="btn btn-primary" data-toggle="modal" data-target="#myModal">
                    <i class="fa fa-plus"> Nueva Sección</i>
                </button>
            </div>

        </div>


    </section><!-- /.content -->
</div><!-- /.content-wrapper -->

<!-- Forma nueva seccion-->
<!-- Modal -->
<div class="modal fade" id="myModal" role="dialog">
    <form name="editCampForm" id="guardQuizform" action="editCamp.do" method="post">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Nueva Sección</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Nombre</label>                                                
                        <div class="form-group">
                            <input type="text" name="SectionName" class="form-control" placeholder="Nombre" data-title="No puede estar vacio" required value="${requestScope.SelectedSectionName}" />
                        </div>                                    
                    </div>
                    <div class="form-group">
                        <label>Superficie</label>                                                
                        <div class="form-group">
                            <input type="text" name="Area" class="form-control" placeholder="Superficie" data-title="No puede estar vacio"  value="" />
                        </div>                                    
                    </div>
                    <div class="form-group">
                        <label>Cantidad de Surcos</label>                                                
                        <div class="form-group">
                            <input type="text" name="GrooveQty" class="form-control" placeholder="Surcos" value="" />
                        </div>                                    
                    </div>
                    <div class="form-group">
                        <label>Tipo de Suelo</label>   
                        <select name="idLandType" id="idLandType" class="form-control" data-title="No puede estar vacio" required >
                            <option value="empty"></option>
                            <c:forEach items="${LandType_HashMap}" var="item">
                                <option value="${item.key}">${item.value}</option>
                            </c:forEach>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Tipo de Cinta</label>   
                        <select name="idPipeType" id="idPipeType" class="form-control" data-title="No puede estar vacio">
                            <option value="empty"></option>
                            <c:forEach items="${PipeType_HashMap}" var="item">
                                <option value="${item.key}">${item.value}</option>
                            </c:forEach>
                        </select>
                    </div>                    
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary pull-left" data-dismiss="modal"> 
                        <i class="fa fa-close"> Cerrar</i>
                    </button>
                    <button type="submit" id="btnSaveSection" class="btn btn-primary pull-right"> 
                        <i class="fa fa-save"> Guardar</i>
                    </button>
                    <input type="hidden" name="idCamp" id="idCamp" value="${requestScope.idCamp}"/>
                    <input type="hidden" name="Action" id="Action"  value="SaveSection"/>
                </div>
            </div>
        </div>
    </form>
</div>


<div class="modal fade" id="confirmModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form name="formConfirm" action="editCamp.do" method="post">
                <div class="modal-header alert-warning">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="myModalLabel"><i class="icon fa fa-trash"></i> Borrar Sección</h4>
                </div>
                <div class="modal-body">
                    <p><h3>Esta usted seguro de borrar este registro?</h3></p>
                    <input type="hidden" name="idCampSection" id="id4Delete" value=""/>
                    <input type="hidden" name="idCamp" id="idCamp" value="${requestScope.idCamp}"/>
                    <input type="hidden" name="Action" id="Action" value="DeleteCampSection"/>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary pull-left" data-dismiss="modal">No</button>
                    <button type="submit" id="btnConfirmYes" class="btn btn-primary pull-right">Si</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="hide">
    <form name="frmAddCrop" id="frmAddCrop" method="post" action="addCrop.do">
        <input type="hidden" id="selectedIdCampSection" name="idCampSection" value=""/>
        <input type="hidden" id="idCamp" name="idCamp" value="${requestScope.idCamp}"/>
    </form>
</div>   


<c:if test="false">
    <c:forEach items='${requestScope}' var='p'>
        <ul>
            <%-- Display the key of the current item, which
                 represents the parameter name --%>
            <li>Parameter Name: <c:out value='${p.key}'/></li>

            <%-- Display the value of the current item, which
                 represents the parameter value --%>
            <li>Parameter Value: <c:out value='${p.value}'/></li>
        </ul>
    </c:forEach>
</c:if>
